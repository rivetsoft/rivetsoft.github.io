---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import SiteMenu from "../components/SiteMenu.astro";
import { url } from "../paths";

interface Props {
  title: string;
  description: string;
  current?: string;
  jsonLd?: unknown[];
  ogType?: string;
}

const { title, description, current = "", jsonLd = [], ogType = "website" } = Astro.props;
const documentTitle = current === "home" ? "Rivet" : `${title} | Rivet`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <Seo title={documentTitle} description={description} jsonLd={jsonLd} ogType={ogType} />
    <link rel="icon" href={url("rivet-mark.svg")} type="image/svg+xml" />
    <script
      is:inline
      defer
      src="https://analytics.stevenswebhosting.com/script.js"
      data-website-id="6e7cbc54-64b7-4cc5-9304-d5c2dc7a08a0"
      data-domains="rivetsoft.github.io"></script>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("rivet-theme") || localStorage.getItem("starlight-theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.dataset.theme = stored;
            localStorage.setItem("rivet-theme", stored);
            localStorage.setItem("starlight-theme", stored);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="mast">
      <div class="mast-inner">
        <SiteMenu current={current} />
      </div>
    </header>
    <main id="content" class="column">
      <slot />
    </main>
    <footer class="site-footer column">
      <div class="site-footer-inner">
        <div class="site-footer-copy">
          <p>
            <a href="https://github.com/rivetsoft/apps/blob/main/LICENSE-MIT">MIT</a> or
            <a href="https://github.com/rivetsoft/apps/blob/main/LICENSE-APACHE">Apache-2.0</a>.
            Code on <a href="https://github.com/rivetsoft/apps">GitHub</a>.
          </p>
          <p class="visits">Visits are counted with self-hosted Umami. No cookies, no personal data.</p>
        </div>
        <slot name="footer-aside" />
      </div>
    </footer>
  </body>
</html>
