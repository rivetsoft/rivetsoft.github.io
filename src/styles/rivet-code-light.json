{
  "name": "Rivet Light",
  "type": "light",
  "colors": {
    "editor.background": "#e9dee5",
    "editor.foreground": "#2a2a2a"
  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#2a2a2a"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#87767f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.control", "keyword.operator.new", "constant.language"],
      "settings": {
        "foreground": "#bd3ace"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#5c7522"
      }
    },
    {
      "scope": ["constant.numeric", "constant.character", "constant.other"],
      "settings": {
        "foreground": "#8c7622"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#1383be"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class", "storage.type.class"],
      "settings": {
        "foreground": "#81731d"
      }
    },
    {
      "scope": ["punctuation", "keyword.operator", "meta.brace"],
      "settings": {
        "foreground": "#636062"
      }
    }
  ]
}
