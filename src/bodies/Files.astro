---
import Shot from "../components/Shot.astro";
import ReleaseBlock from "../components/ReleaseBlock.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { appBySlug, repoUrl } from "../data/apps";
import { archiveFolder, assetByKind } from "../data/release-model";
import { releaseFor } from "../data/releases";
import { url } from "../paths";

const app = appBySlug("files");
const release = releaseFor("files");
const appImage = release ? assetByKind(release, "appimage") : undefined;
const archive = release ? assetByKind(release, "archive") : undefined;
const flatpak = release ? assetByKind(release, "flatpak") : undefined;
---

<h1 class="app-title">
  <img src={url("rivet-files.svg")} width="48" height="48" alt="" />
  Rivet Files
</h1>
<StatusBadge app={app} release={release} />
<p>
  A Linux file manager in the same vein as Dolphin, Nemo, Thunar, and Caja. It is written in Rust,
  draws with egui, and does not use GTK or Qt. You can fill the window with every bar and panel, or
  keep a short toolbar and the files.
</p>
<p>
  {
    release ? (
      <>
        The latest download is <a href={release.htmlUrl}>{release.version}</a>, published {release.dateLabel}.
      </>
    ) : (
      <>No release is published yet.</>
    )
  }
  The builds are x86_64. On main, the changelog still lists split view, custom actions, thumbnails beyond
  pictures, and copying files to other programs under Unreleased. Those are in the current source and in
  the README.{release && <> They may not be in the {release.version} files yet.</>}
</p>

<div class="pair">
  <Shot
