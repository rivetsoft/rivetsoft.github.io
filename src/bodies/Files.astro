---
import PageBand from "../components/PageBand.astro";
import ReleaseBlock from "../components/ReleaseBlock.astro";
import Throwback from "../components/Throwback.astro";
import shots from "../data/shots.json";
import { appBySlug, repoUrl, statusFor, statusLabel } from "../data/apps";
import { assetByKind, formatBytes } from "../data/release-model";
import { releaseFor } from "../data/releases";
import { url } from "../paths";
// Rivet among the papers of an open folder, beside the downloads.
import filesArt from "../assets/mascot/files.svg?raw";

const app = appBySlug("files");
const release = releaseFor("files");
const status = statusFor(app, release);
const table = shots as Record<string, { w: number; h: number }>;
const shot = (name: string) => ({ src: url(`screenshots/${name}`), ...table[name] });

// The page's rows: a screenshot, a claim, and what backs it up.
const rows = [
  {
    shot: "columns-wide.png",
    alt: "Rivet Files in Miller columns view",
    title: "Four views. Tabs. A split.",
    line: "Browse the way you already do.",
    points: [
      { icon: "floppy", text: "Icons, list, compact and Miller columns" },
      { icon: "die", text: "Tabs, and a split view with drag between panes" },
      { icon: "squiggle", text: "A stepped path bar with fuzzy completion" },
      { icon: "globe", text: "Places, drives, SMB shares, or a folder tree in the sidebar" },
    ],
  },
  {
    shot: "peek-code-wide.png",
    alt: "The Peek panel showing highlighted Rust code",
    title: "Peek before you open.",
    line: "A side panel that shows what is in the file.",
    points: [
      { icon: "eye", text: "Images, video playback, code and file details" },
      { icon: "lavalamp", text: "Syntax highlighting in the theme's colors" },
      { icon: "cassette", text: "Thumbnails from the system's thumbnailers, cache shared" },
      { icon: "cd", text: "A full-window Preview that steps through the folder" },
    ],
  },
  {
    shot: "quick-open-wide.png",
    alt: "Quick Open jumping to a folder",
    title: "Type a few letters.",
    line: "Quick Open and Quick Actions on one panel, as in every Rivet app.",
    points: [
      { icon: "bolt", text: "Fuzzy-find any folder, bookmark or drive" },
      { icon: "burst", text: "Every command and setting in one searchable list" },
      { icon: "hourglass", text: "Filters by type, name or date, per folder or everywhere" },
      { icon: "yinyang", text: "Vim keys, optional" },
    ],
  },
  {
    shot: "bulk-rename-wide.png",
    alt: "Bulk Rename previewing new names",
    title: "Batch work, built in.",
    line: "The jobs that usually mean another program.",
    points: [
      { icon: "checkbox", text: "Bulk rename, with every new name previewed" },
      { icon: "tamagotchi", text: "Convert and resize images, video and audio with ffmpeg" },
      { icon: "pager", text: "zip, tar.gz, tar.xz, tar.zst and 7z" },
      { icon: "peace", text: "Undo and redo for copies, moves, renames and Trash" },
    ],
  },
  {
    shot: "file-picker-wide.png",
    alt: "Rivet Files as another app's Save window",
    title: "The desktop's file picker.",
    line: "One file manager, in every Open and Save dialog.",
    points: [
      { icon: "alien", text: "An xdg-desktop-portal backend" },
      { icon: "cursor", text: "Other apps' Open and Save windows become Rivet Files" },
      { icon: "sign", text: "Not in the Flatpak. The picker you had stays as the fallback" },
    ],
  },
];

// How much file manager you want, least to most, then the two odd ones.
const modes = [
  { shot: "minimal-wide.png", alt: "Minimal: a short toolbar and the files", name: "Minimal", text: "A menu button, back and forward, the path, two views." },
  { shot: "bloated-wide.png", alt: "Bloated: menu bar, full toolbar, tabs, status bar and Peek", name: "Bloated", text: "Every bar, button and panel, all at once." },
  { shot: "zen-wide.png", alt: "Zen mode: the files fill the window, with no toolbar or sidebar showing", name: "Zen", text: "Files fill the window. Panels slide in from the edges." },
  { shot: "terminal-wide.png", alt: "Terminal mode: monospace text and boxed panels", name: "Terminal mode", text: "Monospace, Nerd Font icons, boxed panels. Same features." },
];

const themes = [
  { shot: "theme-rose-wide.png", name: "Rose" },
  { shot: "theme-ember-wide.png", name: "Ember" },
  { shot: "theme-moss-wide.png", name: "Moss" },
  { shot: "theme-violet-wide.png", name: "Violet" },
];

const appImage = release ? assetByKind(release, "appimage") : undefined;
// From the README's bench: one folder of 100,000 empty files on btrfs, median of five launches.
const numbers = [
  { figure: "367 ms", label: "to the first window, on a folder of 100,000 files" },
  { figure: "0.5 s", label: "until it has settled and stopped using the CPU" },
  { figure: "76 MiB", label: "of memory with those 100,000 files listed" },
  { figure: appImage ? formatBytes(appImage.size) : "8 MB", label: "for the whole AppImage" },
];
---

<PageBand>
  <p class="app-kicker">
    <img src={url(app.icon ?? "rivet-files.svg")} width="40" height="40" alt="" />
    <span class={`badge badge-${status}`}>{statusLabel[status]}</span>
    {release && <span class="app-version">{release.version}, {release.dateLabel}</span>}
  </p>
  <h1>Rivet Files</h1>
  <p class="band-page-lead">A Linux file manager with no GTK or Qt.</p>
  <p>
    Rust and egui, in the vein of Dolphin, Nemo, Thunar and Caja. Fill the window with every bar and
    panel, or keep a short toolbar and the files.
  </p>
  <div class="cta-actions">
    <a class="btn btn-primary" href="#download">{release ? `Download ${release.version} →` : "Download →"}</a>
    <a class="btn btn-secondary" href={url("docs/files/")}>Docs</a>
    <a class="btn btn-secondary" href={`${repoUrl}/tree/main/apps/rivet-files`}>GitHub</a>
  </div>
  <a slot="art" class="app-hero-shot" href={shot("icons-wide.png").src}>
    <img
      src={shot("icons-wide.png").src}
      alt="Rivet Files in the pink scheme, icon view of Home"
      width={shot("icons-wide.png").w}
      height={shot("icons-wide.png").h}
      fetchpriority="high"
      decoding="async"
    />
  </a>
</PageBand>

<section class="band band-apps app-rows" aria-label="What it does">
  <ul class="showcase">
    {
      rows.map((row) => (
        <li class="show-row">
          <a class="show-shot-link" href={shot(row.shot).src}>
            <img class="show-shot" src={shot(row.shot).src} alt={row.alt} width={shot(row.shot).w} height={shot(row.shot).h} decoding="async" loading="lazy" />
          </a>
          <div class="show-copy">
            <h2 class="app-row-title">{row.title}</h2>
            <span class="card-summary">{row.line}</span>
            <ul class="show-points">
              {row.points.map((point) => (
                <li>
                  <Throwback name={point.icon} />
                  <span>{point.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<section class="band app-modes" aria-labelledby="modes-title">
  <h2 id="modes-title">As much file manager as you want.</h2>
  <p class="app-band-lead">
    Toolbar top or bottom, your own buttons, an optional menu bar, the desktop's title bar or Rivet's
    own. Or pick a mode and be done.
  </p>
  <ul class="app-grid app-grid-4">
    {
      modes.map((mode) => (
        <li>
          <a href={shot(mode.shot).src}>
            <img src={shot(mode.shot).src} alt={mode.alt} width={shot(mode.shot).w} height={shot(mode.shot).h} decoding="async" loading="lazy" />
          </a>
          <h3>{mode.name}</h3>
          <p>{mode.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="band band-colors app-themes" aria-labelledby="themes-title">
  <h2 id="themes-title">It wears your wallpaper.</h2>
  <p class="app-band-lead">
    Colors follow matugen, Noctalia, Dux Shell and GTK themes while the window is open. The built-in
    icons recolor from the same palette, or use the system's icon theme.
  </p>
  <ul class="app-grid app-grid-4">
    {
      themes.map((theme) => (
        <li>
          <a href={shot(theme.shot).src}>
            <img src={shot(theme.shot).src} alt={`Rivet Files in the ${theme.name} colors`} width={shot(theme.shot).w} height={shot(theme.shot).h} decoding="async" loading="lazy" />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<section class="band app-numbers" aria-labelledby="numbers-title">
  <h2 id="numbers-title">Fast, and then idle.</h2>
  <p class="app-band-lead">
    It draws only when something changes, so an open window uses no CPU.
    <a href={`${repoUrl}/blob/main/apps/rivet-files/README.md`}>How these were measured</a> is in the README.
  </p>
  <ul class="app-stats">
    {
      numbers.map((n) => (
        <li>
          <strong>{n.figure}</strong>
          <span>{n.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<section class="band band-apps app-download" id="download" aria-labelledby="download-title">
  <div class="app-download-copy">
    <h2 id="download-title">Get Rivet Files.</h2>
    <p class="app-band-lead">
      x86_64 builds for Ubuntu 22.04, Debian 12 and newer. The AppImage is one file; the archive installs
      for your user, with no root.
    </p>
    <ReleaseBlock slug="files" />
    <p class="app-download-more">
      <a href={url("docs/getting-started/install/")}>Install guide</a>
      <a href={url("docs/files/#installing")}>Flatpak, Arch and building from source</a>
      <a href={`${repoUrl}/blob/main/apps/rivet-files/CHANGELOG.md`}>Changelog</a>
    </p>
    <p class="app-download-small">Crash reports stay on your computer. Nothing is sent unless you choose to share it.</p>
  </div>
  <div class="app-download-rivet" role="img" aria-label="Rivet, the mascot, pops up out of an open folder among its papers." set:html={filesArt} />
</section>
