---
import AppPage from "../components/AppPage.astro";
import { repoUrl } from "../data/apps";
import { shotPic } from "../data/pics";
import { releaseFor } from "../data/releases";
import { url } from "../paths";
import art from "../assets/mascot/ftp.svg?raw";

const release = releaseFor("ftp");
---

<AppPage
  slug="ftp"
  lead="A classic two-pane SFTP client."
  text="This computer on one side, the server on the other, and a transfer queue underneath. Saved connections work from the terminal too. FTP and FTPS are not built yet."
  hero={shotPic("ftp-connected-wide.png", "Rivet FTP in the pink scheme, connected, with this computer and the server side by side")}
  rows={[
    {
      pic: shotPic("ftp-new-connection-wide.png", "The New Connection window, with SFTP selected"),
      title: "Connections you keep.",
      line: "Saved once. Used from the window and from the terminal.",
      points: [
        { icon: "cd", text: "Groups in the sidebar, and tabs for several servers at once" },
        { icon: "bolt", text: "A quick-connect bar for an address you do not want to save" },
        { icon: "eightball", text: "Bring your GUI connections into the terminal: ssh, scp, rsync and git by name" },
        { icon: "floppy", text: "One plain text file. Passwords go in the desktop keyring, never the file" },
      ],
    },
    {
      pic: shotPic("ftp-replace-wide.png", "A dialog comparing two items that are already on the server"),
      title: "Transfers that ask first.",
      line: "Drag a file or a whole folder across.",
      points: [
        { icon: "burst", text: "A queue with progress, speed and time left. Retry what failed" },
        { icon: "hourglass", text: "Dates and sizes compared before anything is replaced" },
        { icon: "die", text: "Keep it, replace the older files, or replace all" },
        { icon: "squiggle", text: "A tab in the background keeps transferring" },
      ],
    },
    {
      pic: shotPic("ftp-info-wide.png", "Info for a file on the server, with owner, size, and permission checkboxes"),
      title: "Edit on the server.",
      line: "Your editor, their file.",
      points: [
        { icon: "cursor", text: "Open a remote file in your own editor. Every save goes back" },
        { icon: "sign", text: "It asks first if the server's copy changed in the meantime" },
        { icon: "checkbox", text: "Owner, size and permissions, for one file or a whole folder" },
        { icon: "eye", text: "Previews for pictures and text" },
      ],
    },
    {
      pic: shotPic("ftp-keys-wide.png", "Preferences, SSH Keys, in the light theme"),
      title: "Your SSH, not a copy of it.",
      line: "SFTP runs through the system's own sftp program.",
      points: [
        { icon: "alien", text: "Your keys, agent, ssh config and known hosts all apply" },
        { icon: "tamagotchi", text: "Make a key, copy its public half, add it to a server" },
        { icon: "yinyang", text: "Each connection picks its key. Private keys stay on your computer" },
        { icon: "flame", text: "A new server is trusted on first use. A changed key is refused" },
      ],
    },
  ]}
  facts={{
    title: "Still under construction.",
    lead: "It is an alpha. These are on the list, and not in the app yet.",
    items: [
      { icon: "sign", title: "FTP and FTPS", text: "The addresses can be saved. Opening them is not built yet." },
      { icon: "hourglass", title: "Pause and resume", text: "And a bandwidth limit." },
      { icon: "burst", title: "Several transfers at once", text: "The queue runs one at a time today." },
      { icon: "globe", title: "Folder sync", text: "And reconnecting after a drop." },
    ],
  }}
  gallery={{
    title: "Light or dark, it follows the desktop.",
    lead: "Colors, fonts and the icon theme come from the desktop. The toolbar can be arranged and the menu bar hidden.",
    items: [
      { pic: shotPic("ftp-light-wide.png", "Rivet FTP in the light theme, with both panes showing the same site") },
      { pic: shotPic("ftp-preferences-wide.png", "Preferences, Transfers: ask, replace, or skip when a file is already there") },
    ],
  }}
  download={{
    lead: `x86_64 builds for Ubuntu 22.04, Debian 12 and newer. They install for your user, with no root.${release?.prerelease ? " This is a pre-release: try it on servers and files you have backups of." : ""}`,
    links: [
      { href: url("docs/getting-started/install/"), label: "Install guide" },
      { href: url("docs/ftp/#installing"), label: "What it needs, and building from source" },
      { href: `${repoUrl}/blob/main/docs/rivet-ftp-parity.md`, label: "The feature checklist" },
      { href: `${repoUrl}/blob/main/apps/rivet-ftp/CHANGELOG.md`, label: "Changelog" },
    ],
  }}
  art={art}
  artLabel="Rivet, the mascot, sending files to a server."
/>
