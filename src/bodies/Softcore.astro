---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import AppPage, { type Pic } from "../components/AppPage.astro";
import { url } from "../paths";
import art from "../assets/mascot/softcore.svg?raw";
import strip from "../assets/softcore/strip.jpg";
import tabs from "../assets/softcore/tabs.jpg";
import overview from "../assets/softcore/overview.jpg";
import chords from "../assets/softcore/chords.jpg";
import picker from "../assets/softcore/picker.jpg";
import keys from "../assets/softcore/keys.jpg";
import vertical from "../assets/softcore/vertical.jpg";

// Softcore's pictures are of a whole 1920x1080 display: the page shows them sized to the screen,
// and the link opens a full-size WebP.
async function pic(image: ImageMetadata, alt: string): Promise<Pic> {
  const full = await getImage({ src: image, format: "webp" });
  return { img: image, alt, full: full.src };
}
---

<AppPage
  slug="softcore"
  lead="A scrolling Wayland compositor that feels oh so good."
  text="Keep scrolling, side-to-side, or up and down. Softcore has your fix. Built in Rust with Smithay. All the modern niceties you'd come to expect. Giving you just enough to see. No matter if your windows are big or small. All size windows welcome here. We don't judge."
  hero={await pic(strip, "Softcore with Rivet Files, Rivet Terminal over Rivet Notes, and Rivet Edit in three columns, the outer two cut off by the edges of the screen")}
  rows={[
    {
      pic: await pic(tabs, "A column in Softcore shown as tabs, with a strip across its top"),
      title: "Zip across the plane",
      line: "Fit all the windows you want to scroll through",
      points: [
        { icon: "die", text: "Workspaces are assigned per display" },
        { icon: "cassette", text: "Supports tab stacked windows" },
        { icon: "burst", text: "Whatever floats your boat or scratchpads. Yeah float them windows, bay bay." },
        { icon: "squiggle", text: "You wanna scroll up and down? Get down with your bad self." },
      ],
    },
    {
      pic: await pic(overview, "The Softcore overview, with two workspaces drawn at half size over the wallpaper"),
      title: "See it all at a glance",
      line: "All workspaces all the time, all at once.",
      points: [],
    },
    {
      pic: await pic(chords, "A chord in Softcore: after Mod+G, a panel lists Terminal, Files, Edit, Notes and Internet with their keys"),
      title: "Push all the right buttons",
      line: "Bind anything to anything. If you know niri's actions, you already know ours.",
      points: [
        { icon: "tamagotchi", text: "Chords: hit one key, then another. A panel tells you what comes next. No pressure." },
        { icon: "globe", text: "Forgot a binding? There's a panel for that too." },
        { icon: "flame", text: "Vim people, we see you. H, J, K and L work in the chord panel." },
      ],
    },
    {
      pic: await pic(picker, "Softcore's screen sharing picker, with a card for the display and for each window"),
      title: "Put on a show",
      line: "Screen sharing is built in. Pick a window or a display and go.",
      points: [
        { icon: "alien", text: "Every display and window gets a card with a live preview" },
        { icon: "hourglass", text: "Share a window and the stream sticks with it, even off screen" },
      ],
    },
  ]}
  facts={{
    title: "Made for Rivet.",
    lead: "Softcore and Rivet Shell were made for each other.",
    items: [
      { icon: "yinyang", title: "Dressed to match", text: "Borders and panels wear the desktop's colors, and change when the desktop does." },
      { icon: "smiley", title: "Rivet Shell on top", text: "Panels, dock and launcher sit right on top. Workspaces, window titles and displays all work." },
      { icon: "lavalamp", title: "One settings file", text: "Plain key=value lines. Save it and Softcore reads it again." },
      { icon: "peace", title: "House rules", text: "Tell any window where to go, whether to float, and how see-through to be." },
    ],
  }}
  gallery={{
    title: "Show a little more.",
    lead: "Both pictures are from a headless Softcore, with Rivet Shell and the Rivet apps running in it.",
    items: [
      { pic: await pic(keys, "The Softcore keys panel, listing every binding in two columns"), name: "Every binding", text: "All of them, on one panel." },
      { pic: await pic(vertical, "A Softcore workspace scrolling up and down, with Rivet Edit above Rivet Terminal"), name: "Up and down", text: "Rows one under the other, each as wide as the screen." },
    ],
  }}
  download={{
    lead: "Softcore is early, and its releases are pre-releases. It installs for everyone on the computer and joins the login screen's list of sessions. Keep another session to log in to, and be gentle.",
    links: [
      { href: url("docs/softcore/"), label: "Install and run it" },
      { href: url("docs/softcore/status/"), label: "What isn't built yet" },
    ],
  }}
  art={art}
  artLabel="Rivet, the mascot, beside a strip of windows that runs off both sides."
/>
