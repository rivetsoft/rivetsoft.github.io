---
import Shot from "../components/Shot.astro";
import ReleaseBlock from "../components/ReleaseBlock.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { appBySlug, repoUrl } from "../data/apps";
import { archiveFolder, assetByKind } from "../data/release-model";
import { releaseFor } from "../data/releases";
import { url } from "../paths";

const app = appBySlug("notes");
const release = releaseFor("notes");
const archive = release ? assetByKind(release, "archive") : undefined;
const repo = repoUrl;
---

<h1 class="app-title">
  <img src={url("rivet-notes.svg")} width="48" height="48" alt="" />
  Rivet Notes
</h1>
<StatusBadge app={app} release={release} />
<p>
  Markdown notes in plain folders. A vault is any folder of <code>.md</code> files, so there is
  nothing to import and nothing locked in. Any other Markdown app can open the same notes. It is
  written in Rust, draws with egui, and does not use GTK or Qt. Theme, desktop colors, icons,
  fonts, and in-app windows are the same parts Rivet Files and Rivet FTP use.
</p>
<p>
  {release?.prerelease && "Early alpha. "}
  {release ? (
    <>
      The latest download is <a href={release.htmlUrl}>{release.version}</a>, published {release.dateLabel}.
      {release.prerelease && " GitHub marks it as a pre-release."}
    </>
  ) : (
    <>No release is published yet.</>
  )}
  {release?.prerelease && " It is usable, and still young: things may change or break. Try it on a copy of notes you have backups of."}
</p>

<Shot
  name="notes-live-wide.png"
  alt="Rivet Notes in live mode, with Peek open on a note called Launch plan"
  caption="Live mode, with Peek open. The line you are on stays Markdown. Screenshot from the repository, of a demo vault."
  eager
/>

