---
import PageBand from "../components/PageBand.astro";
import ReleaseBlock from "../components/ReleaseBlock.astro";
import Screenshot from "../components/Screenshot.astro";
import Throwback from "../components/Throwback.astro";
import { appBySlug, repoUrl, statusFor, statusLabel } from "../data/apps";
import { releaseFor } from "../data/releases";
import { screenshot, shotSizes } from "../data/shots";
import { url } from "../paths";
// Rivet at a note, beside the downloads.
import notesArt from "../assets/mascot/notes.svg?raw";

const app = appBySlug("notes");
const release = releaseFor("notes");
const status = statusFor(app, release);

// The page's rows: a screenshot, a claim, and what backs it up.
const rows = [
  {
    shot: "notes-reading-wide.png",
    alt: "The reading view of a note, with a code block and a picture",
    title: "It is just Markdown.",
    line: "Three ways to look at the same file.",
    points: [
      { icon: "cassette", text: "Live mode renders every line but the one you are on" },
      { icon: "pager", text: "Source mode: the Markdown as written, in color" },
      { icon: "eye", text: "A reading view with tables, code blocks and pictures" },
    ],
  },
  {
    shot: "notes-slash-wide.png",
    alt: "The slash menu open in a note, in the light theme",
    title: "Blocks, without the lock-in.",
    line: "The editor does the typing. The file stays text.",
    points: [
      { icon: "burst", text: "A slash menu for headings, lists, todos, quotes and code blocks" },
      { icon: "cursor", text: "Drag a line, a nested list or a whole code block by its handle" },
      { icon: "bolt", text: "A formatting bar on selected text" },
      { icon: "floppy", text: "Drop a file in: it is copied into the vault and linked" },
    ],
  },
  {
    shot: "notes-quick-open-wide.png",
    alt: "Quick Open matching a note from a few letters",
    title: "Linked both ways, found in a few letters.",
    line: "Notes point at each other, and the app keeps the pointers right.",
    points: [
      { icon: "yinyang", text: "Bi-directional links, to a note or a heading, suggested as you type" },
      { icon: "globe", text: "Backlinks listed in Peek" },
      { icon: "squiggle", text: "Rename a note and the links to it follow" },
      { icon: "hourglass", text: "Quick Open by title or folder; search by title, path, first line and tag" },
    ],
  },
  {
    shot: "notes-todos-board-wide.png",
    alt: "The Todos page as a board, with To do, In progress, and Done columns",
    title: "Todos that stay plain text.",
    line: "Two optional modules. Turn on what you use.",
    points: [
      { icon: "checkbox", text: "Super todos: a due date, a priority and progress, written in the note" },
      { icon: "die", text: "One Todos page for the vault, as a list or a kanban board" },
      { icon: "tamagotchi", text: "Daily notes: one per day, named by its date, in a folder you pick" },
    ],
  },
];

// What a vault is, and is not.
const facts = [
  { icon: "alien", title: "No database", text: "A vault is any folder. Nothing is added to it: no index, no hidden settings." },
  { icon: "lavalamp", title: "Properties are YAML", text: "Frontmatter shows as text, numbers, checkboxes, dates, lists, tags and links. Saving writes back only what changed." },
  { icon: "flame", title: "Saves as you type", text: "A note changed by another program reloads. Keep several vaults and switch between them." },
  { icon: "peace", title: "Trash, not delete", text: "Deleting a note moves it to the desktop's Trash." },
];

const looks = [
  { shot: "notes-source-dark.png", alt: "Source mode in the pink scheme" },
  { shot: "notes-source-wide.png", alt: "Source mode in the light theme" },
  { shot: "notes-todos-list-wide.png", alt: "The Todos page as a list, in the light theme" },
  { shot: "notes-preferences-wide.png", alt: "Preferences, Modules" },
];
---

<PageBand>
  <p class="app-kicker">
    <img src={url(app.icon ?? "rivet-notes.svg")} width="40" height="40" alt="" />
    <span class={`badge badge-${status}`}>{statusLabel[status]}</span>
    {release && <span class="app-version">{release.version}, {release.dateLabel}</span>}
  </p>
  <h1>Rivet Notes</h1>
  <p class="band-page-lead">Markdown notes in plain folders.</p>
  <p>
    A vault is any folder of Markdown files. Nothing to import, nothing locked in, and any other
    Markdown app can open the same notes.
  </p>
  <div class="cta-actions">
    <a class="btn btn-primary" href="#download">{release ? `Download ${release.version} →` : "Download →"}</a>
    <a class="btn btn-secondary" href={url("docs/notes/")}>Docs</a>
    <a class="btn btn-secondary" href={`${repoUrl}/tree/main/apps/rivet-notes`}>GitHub</a>
  </div>
  <a slot="art" class="app-hero-shot" href={screenshot("notes-live-wide.png").src}>
    <Screenshot img={screenshot("notes-live-wide.png")} alt="Rivet Notes in the pink scheme, live mode, with Peek open" sizes={shotSizes.hero} eager />
  </a>
</PageBand>

<section class="band band-apps app-rows" aria-label="What it does">
  <ul class="showcase">
    {
      rows.map((row) => (
        <li class="show-row">
          <a class="show-shot-link" href={screenshot(row.shot).src}>
            <Screenshot class="show-shot" img={screenshot(row.shot)} alt={row.alt} sizes={shotSizes.row} />
          </a>
          <div class="show-copy">
            <h2 class="app-row-title">{row.title}</h2>
            <span class="card-summary">{row.line}</span>
            <ul class="show-points">
              {row.points.map((point) => (
                <li>
                  <Throwback name={point.icon} />
                  <span>{point.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<section class="band app-modes" aria-labelledby="vault-title">
  <h2 id="vault-title">Your folder stays your folder.</h2>
  <p class="app-band-lead">
    The notes are files and the folders are folders. Point another editor, a sync tool or git at the
    same place.
  </p>
  <ul class="app-facts">
    {
      facts.map((fact) => (
        <li>
          <Throwback name={fact.icon} />
          <h3>{fact.title}</h3>
          <p>{fact.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="band band-colors app-themes" aria-labelledby="looks-title">
  <h2 id="looks-title">Light or dark, it follows the desktop.</h2>
  <p class="app-band-lead">
    Colors, fonts and the icon theme come from the desktop, the same way as the other Rivet apps.
    Fonts, text size and line spacing for the notes are yours to set.
  </p>
  <ul class="app-grid app-grid-4">
    {
      looks.map((look) => (
        <li>
          <a href={screenshot(look.shot).src}>
            <Screenshot img={screenshot(look.shot)} alt={look.alt} sizes={shotSizes.grid} />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<section class="band band-apps app-download" id="download" aria-labelledby="download-title">
  <div class="app-download-copy">
    <h2 id="download-title">Get Rivet Notes.</h2>
    <p class="app-band-lead">
      x86_64 builds for Ubuntu 22.04, Debian 12 and newer. The AppImage is one file; the archive installs
      for your user, with no root.
      {release?.prerelease && " This is a pre-release: try it on notes you have backups of."}
    </p>
    <ReleaseBlock slug="notes" />
    <p class="app-download-more">
      <a href={url("docs/getting-started/install/")}>Install guide</a>
      <a href={url("docs/notes/#installing")}>What it needs, and building from source</a>
      <a href={`${repoUrl}/blob/main/apps/rivet-notes/CHANGELOG.md`}>Changelog</a>
    </p>
  </div>
  <div class="app-download-rivet" role="img" aria-label="Rivet, the mascot, with a note." set:html={notesArt} />
</section>
