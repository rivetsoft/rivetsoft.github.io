---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import AppPage, { type Pic } from "../components/AppPage.astro";
import { repoUrl } from "../data/apps";
import { releaseFor } from "../data/releases";
import { url } from "../paths";
import art from "../assets/mascot/shell.svg?raw";
import desktop from "../assets/hero/hero-desktop.jpg";
import sunset from "../assets/shell/desktop.jpg";
import commandsNotes from "../assets/shell/commands-notes.jpg";
import notesMenu from "../assets/shell/notes-menu.jpg";
import quickSettings from "../assets/shell/quick-settings.jpg";
import settingsAppearance from "../assets/shell/settings-appearance.jpg";
import settingsPanels from "../assets/shell/settings-panels.jpg";
import settingsPlugins from "../assets/shell/settings-plugins.jpg";
import settingsLauncher from "../assets/shell/settings-launcher.jpg";
import settingsWidgets from "../assets/shell/settings-widgets.jpg";

const release = releaseFor("shell");

// The shell's pictures are photographs of a whole desktop: sized down for the page, with the
// original behind the link.
async function pic(image: ImageMetadata, alt: string, width = 1440): Promise<Pic> {
  const small = await getImage({ src: image, width, format: "webp" });
  const full = await getImage({ src: image, format: "webp" });
  const w = Math.min(width, image.width);
  return { src: small.src, w, h: Math.round((image.height * w) / image.width), alt, full: full.src };
}
---

<AppPage
  slug="shell"
  lead="A Wayland desktop shell."
  text={`Panels, a dock, a launcher, quick settings, notifications, widgets and the wallpaper. For compositors with layer-shell: niri, Hyprland, Sway and others, not GNOME.${release ? "" : " There is no release yet, so you build it from source."}`}
  hero={await pic(desktop, "Rivet Shell with a floating top panel, a clock and system readings, and a dock, over a wallpaper of Rivet at dusk")}
  rows={[
    {
      pic: await pic(quickSettings, "Rivet Shell quick settings: volume, brightness, toggles, and what is playing"),
      title: "A panel you arrange.",
      line: "Top or bottom, floating or edge to edge.",
      points: [
        { icon: "die", text: "Workspaces, window title, clock, media, tray, notifications and power" },
        { icon: "bolt", text: "Volume, brightness, network, Bluetooth and battery" },
        { icon: "burst", text: "Quick settings, opened from the panel" },
        { icon: "floppy", text: "A dock of pinned apps, then open ones" },
      ],
    },
    {
      pic: await pic(commandsNotes, "The launcher after @notes, listing notes and New Note"),
      title: "A launcher with commands.",
      line: "It opens in the middle of the screen and searches installed apps.",
      points: [
        { icon: "cursor", text: "@ runs a command, such as @notes or @ftp" },
        { icon: "squiggle", text: "The same fuzzy matching as the apps' quick panel" },
        { icon: "eye", text: "A grid or a list, at the size you set" },
      ],
    },
    {
      pic: await pic(notesMenu, "The Notes panel item: tasks with a due badge, and the latest notes"),
      title: "Plugins from the apps.",
      line: "An app joins the shell through a plugin. Other people's plugins do the same.",
      points: [
        { icon: "checkbox", text: "Notes: tasks and the latest notes on the panel, with a badge when one is due" },
        { icon: "cd", text: "FTP: saved connections on the panel, opened already connected" },
        { icon: "cassette", text: "Edit: your five most recent folders" },
        { icon: "alien", text: "A plugin can add a panel item, a menu and launcher entries" },
      ],
    },
    {
      pic: await pic(sunset, "Rivet Shell over a sunset wallpaper, in colors made from it"),
      title: "It wears your wallpaper.",
      line: "Wallpaper on every screen, and colors made from it.",
      points: [
        { icon: "lavalamp", text: "matugen colors the desktop from the picture you choose" },
        { icon: "yinyang", text: "The Rivet apps follow those colors while they are open" },
        { icon: "hourglass", text: "It paints with its own software renderer, and only on a change. No GPU" },
      ],
    },
  ]}
  gallery={{
    title: "Settings for all of it.",
    lead: "Pages for Wallpaper, Appearance, Panels, Dock, Widgets, Launcher, Notifications, Displays, Idle & Lock, Plugins and About.",
    items: [
      { pic: await pic(settingsAppearance, "Rivet Shell settings, Appearance page, with style, accent, and color use", 960), name: "Appearance" },
      { pic: await pic(settingsPanels, "Rivet Shell settings, Panels page, with a floating top panel and its items", 960), name: "Panels" },
      { pic: await pic(settingsWidgets, "Rivet Shell settings, Widgets page, with the clock and system readings", 960), name: "Widgets" },
      { pic: await pic(settingsPlugins, "Rivet Shell settings, Plugins page, with the official Notes and FTP plugins", 960), name: "Plugins" },
    ],
  }}
  download={{
    lead: release
      ? "Early, so rough edges are expected. It also builds from source with Rust 1.88 or newer."
      : "It builds from source with Rust 1.88 or newer. Rough edges are expected.",
    links: [
      { href: url("docs/shell/"), label: "How to build and run it" },
      { href: url("plugins/"), label: "Plugins" },
      { href: `${repoUrl}/blob/main/apps/rivet-shell/CHANGELOG.md`, label: "Changelog" },
    ],
  }}
  art={art}
  artLabel="Rivet, the mascot, on a desktop."
/>
