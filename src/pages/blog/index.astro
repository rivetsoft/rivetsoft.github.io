---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { url } from "../../paths";
import { breadcrumb, siteRoot } from "../../seo";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const dateOf = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
---

<Base
  title="Blog"
  description="Short notes from the Rivet repo, newest first."
  current="blog"
  jsonLd={[
    breadcrumb([
      { name: "Rivet", url: siteRoot },
      { name: "Blog", url: `${siteRoot}blog/` },
    ]),
  ]}
>
  <header class="blog-head">
    <h1>Blog</h1>
    <p>Short notes from the repo, newest first.</p>
  </header>
  <ul class="post-cards">
    {
      posts.map((post) => (
        <li>
          <a class="post-card" href={url(`blog/${post.id}/`)}>
            {post.data.cover && (
              <Image
                src={post.data.cover}
                alt={post.data.coverAlt ?? ""}
                widths={[720, 1100, 1440]}
                sizes="(min-width: 800px) 64rem, 100vw"
                class="post-card-cover"
              />
            )}
            <span class="post-card-copy">
              <span class="post-card-title">{post.data.title}</span>
              <span class="post-card-meta">
                <time datetime={post.data.date.toISOString().slice(0, 10)}>{dateOf(post.data.date)}</time>
                <span aria-hidden="true">·</span>
                {post.data.author}
              </span>
              <span class="post-card-excerpt">{post.data.description}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
