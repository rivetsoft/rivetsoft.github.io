---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { url } from "../../paths";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title="Blog" description="Short notes from the Rivet repo." current="blog">
  <h1>Blog</h1>
  <ul class="posts">
    {
      posts.map((post) => (
        <li>
          <a href={url(`blog/${post.id}/`)}>{post.data.title}</a>
          <p>
            <time datetime={post.data.date.toISOString().slice(0, 10)}>
              {post.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
                timeZone: "UTC",
              })}
            </time>
            {" · "}
            {post.data.author}
          </p>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .posts {
    list-style: none;
    padding: 0;
  }

  .posts li {
    margin: 0 0 1.4rem;
  }

  .posts a {
    font-size: 1.35rem;
    font-weight: 640;
    text-decoration: none;
  }

  .posts p {
    margin: 0.25rem 0 0;
  }
</style>
