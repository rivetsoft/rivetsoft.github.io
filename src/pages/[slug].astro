---
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import ReleaseBlock from "../components/ReleaseBlock.astro";
import StatusBadge from "../components/StatusBadge.astro";
import FilesBody from "../bodies/Files.astro";
import FtpBody from "../bodies/Ftp.astro";
import NotesBody from "../bodies/Notes.astro";
import ShellBody from "../bodies/Shell.astro";
import EditBody from "../bodies/Edit.astro";
import { apps, repoUrl, type AppEntry } from "../data/apps";
import { releaseFor } from "../data/releases";
import { url } from "../paths";
import { breadcrumb, siteRoot, softwareApplication } from "../seo";

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

interface Props {
  app: AppEntry;
}

const { app } = Astro.props;
const release = releaseFor(app.slug);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = [
  softwareApplication(app, release, pageUrl),
  breadcrumb([
    { name: "Rivetsoft", url: siteRoot },
    { name: app.name, url: pageUrl },
  ]),
];
const bodies = {
  files: FilesBody,
  ftp: FtpBody,
  notes: NotesBody,
  shell: ShellBody,
  edit: EditBody,
} as const;
const Body = app.template ? bodies[app.template] : null;
const readmeUrl = app.readme ? `${repoUrl}/blob/main/${app.readme}` : repoUrl;
---

<Base title={app.name} description={app.summary} current={app.slug} jsonLd={jsonLd}>
  {
    Body ? (
      <Body />
    ) : (
      <>
        <h1 class="app-title">
          {app.icon && <img src={url(app.icon)} width="48" height="48" alt="" />}
          {app.name}
        </h1>
        <StatusBadge app={app} release={release} />
        <p>{app.summary}</p>
        {app.points && (
          <ul>
            {app.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        )}
        {app.cardShot && app.cardAlt && app.cardCaption && (
          <Shot name={app.cardShot} alt={app.cardAlt} caption={app.cardCaption} eager />
        )}
        <ReleaseBlock slug={app.slug} heading="h2" />
        {app.source && (
          <>
            <h2>From source</h2>
            <p>
              Rust 1.88 or newer. From the top of the <a href={repoUrl}>repository</a>.
              More is in the <a href={readmeUrl}>README</a>.
            </p>
            <pre><code>{app.source}</code></pre>
          </>
        )}
      </>
    )
  }
</Base>
