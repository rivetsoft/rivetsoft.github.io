---
import Base from "../layouts/Base.astro";
import FilesBody from "../bodies/Files.astro";
import FtpBody from "../bodies/Ftp.astro";
import { apps, type AppEntry } from "../data/apps";

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

interface Props {
  app: AppEntry;
}

const { app } = Astro.props;
const bodies = {
  files: FilesBody,
  ftp: FtpBody,
} as const;
const Body = app.template ? bodies[app.template] : null;
---

<Base title={app.name} description={app.summary} current={app.slug}>
  {
    Body ? (
      <Body />
    ) : (
      <>
        <h1>{app.name}</h1>
        <p>{app.summary}</p>
      </>
    )
  }
</Base>
