---
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import ReleaseBlock from "../components/ReleaseBlock.astro";
import StatusBadge from "../components/StatusBadge.astro";
import shots from "../data/shots.json";
import { apps, byReleaseStatus, statusFor, statusLabel } from "../data/apps";
import { catalog, releaseFor } from "../data/releases";
import { url } from "../paths";
import { breadcrumb, siteRoot, websiteAndPerson } from "../seo";

const table = shots as Record<string, { w: number; h: number }>;
const rows = apps.map((app) => {
  const release = releaseFor(app.slug);
  return { app, release, status: statusFor(app, release) };
});
for (const { app } of rows) {
  if (app.cardShot && !table[app.cardShot]) {
    throw new Error(`Missing screenshot ${app.cardShot}`);
  }
}

const shell = rows.find((row) => row.app.spotlight === "shell");
const welcome = rows.find((row) => row.app.spotlight === "welcome");
const appRows = byReleaseStatus(rows.filter((row) => !row.app.spotlight));

const description =
  "A small Linux desktop shell, and apps for files, notes, FTP, editing and the terminal. Each one also runs on its own. Built for fun, held together with rivets.";
---

<Base
  title="Rivet"
  description={description}
  current="home"
  jsonLd={[...websiteAndPerson(description), breadcrumb([{ name: "Rivet", url: siteRoot }])]}
>
  <header class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <img src={url("rivet-shell.svg")} width="36" height="36" alt="" />
        Rivet Shell
      </p>
      <h1>Rivet</h1>
      <p class="lede">{description}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={url("docs/getting-started/install/")}>Getting Started →</a>
        <a class="btn btn-secondary" href={url("docs/")}>Docs</a>
      </div>
      {
        shell && !shell.release && (
          <p class="hero-note">
            Shell has no release yet. Build notes are on the <a href={url("shell/")}>Shell page</a>.
          </p>
        )
      }
      {
        catalog.source === "fallback" && (
          <p class="notice">GitHub was unreachable when this page was built. Versions below are the last saved release info.</p>
        )
      }
    </div>
    <figure class="hero-visual">
      <img
        src={url("screenshots/shell-wide.jpg")}
        alt="Rivet Shell in the pink scheme: panel, widgets and dock over a sunset wallpaper"
        width={table["shell-wide.jpg"].w}
        height={table["shell-wide.jpg"].h}
        decoding="async"
      />
    </figure>
  </header>

  <ul class="facts">
    <li>
      <span class="fact-icon pink" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2"></path>
        </svg>
      </span>
      <h2>One look</h2>
      <p>Menus, toolbars, Preferences, and the quick panel (Ctrl+P) are the same. Colors, fonts, and icons follow the desktop.</p>
    </li>
    <li>
      <span class="fact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 4 7v10l8 4 8-4V7z"></path>
          <path d="M12 21V11M4 7l8 4 8-4"></path>
        </svg>
      </span>
      <h2>Rust, no GTK or Qt</h2>
      <p>The shell and the apps are written in Rust and draw with egui.</p>
    </li>
    <li>
      <span class="fact-icon yellow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <rect x="3" y="4" width="7" height="7" rx="1.5"></rect>
          <rect x="14" y="4" width="7" height="7" rx="1.5"></rect>
          <rect x="8" y="14" width="7" height="7" rx="1.5"></rect>
        </svg>
      </span>
      <h2>Together or apart</h2>
      <p>Each app runs on its own. Put them with the shell and they share a dock and colors.</p>
    </li>
    <li>
      <span class="fact-icon mint" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 4v10"></path>
          <path d="m8 10 4 4 4-4"></path>
          <path d="M5 19h14"></path>
        </svg>
      </span>
      <h2>Unified Install</h2>
      <p>Optional. It downloads a release, checks the sha256, and runs install.sh.</p>
    </li>
    <li>
      <span class="fact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <rect x="4" y="5" width="16" height="12" rx="2"></rect>
          <path d="M8 20h8"></path>
        </svg>
      </span>
      <h2>Theme Follows Your Wallpaper</h2>
      <p>The shell runs matugen on the wallpaper. The apps follow those colors, with no restart.</p>
    </li>
    <li>
      <span class="fact-icon yellow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="8"></circle>
          <path d="M4 12h16M12 4c2.5 2.5 2.5 13.5 0 16M12 4c-2.5 2.5-2.5 13.5 0 16"></path>
        </svg>
      </span>
      <h2>Wayland</h2>
      <p>The apps are for Linux. The shell needs a Wayland compositor with layer-shell, not GNOME.</p>
    </li>
    <li>
      <span class="fact-icon mint" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M12 3v4M12 17v4M5 12H3M21 12h-2"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </span>
      <h2>Draws when it changes</h2>
      <p>The shell paints with its own software renderer, and only when something on screen changed. No GPU.</p>
    </li>
    <li>
      <span class="fact-icon pink" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 4h7l5 5v11a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"></path>
          <path d="M14 4v5h5"></path>
        </svg>
      </span>
      <h2>Open source</h2>
      <p>MIT or Apache-2.0, at your option.</p>
    </li>
  </ul>

  <section class="scheme" aria-labelledby="scheme-title">
    <h2 id="scheme-title">Other accents</h2>
    <p>The default is pink. The same Files window can wear another accent.</p>
    <ul class="scheme-grid">
      <li>
        <img src={url("screenshots/theme-rose-wide.png")} alt="Rivet Files in the rose theme, on a light pink page" width={table["theme-rose-wide.png"].w} height={table["theme-rose-wide.png"].h} />
        <span>Rose</span>
      </li>
      <li>
        <img src={url("screenshots/theme-ember-wide.png")} alt="The same Files window in the ember accent" width={table["theme-ember-wide.png"].w} height={table["theme-ember-wide.png"].h} />
        <span>Ember</span>
      </li>
      <li>
        <img src={url("screenshots/theme-moss-wide.png")} alt="The same Files window in the moss accent" width={table["theme-moss-wide.png"].w} height={table["theme-moss-wide.png"].h} />
        <span>Moss</span>
      </li>
      <li>
        <img src={url("screenshots/theme-violet-wide.png")} alt="The same Files window in the violet accent" width={table["theme-violet-wide.png"].w} height={table["theme-violet-wide.png"].h} />
        <span>Violet</span>
      </li>
    </ul>
  </section>

  {
    welcome && (
      <section class="spotlight" aria-labelledby="welcome-title">
        <h2 id="welcome-title" class="spot-title">
          {welcome.app.icon && (
            <img src={url(welcome.app.icon)} width="40" height="40" alt="" />
          )}
          {welcome.app.name}
        </h2>
        <StatusBadge app={welcome.app} release={welcome.release} />
        <p>
          The way to install the set. It downloads each release, checks the sha256, and runs
          install.sh, so the programs land in <code>~/.local/bin</code> and in your launcher. A
          tray icon looks for newer versions after you sign in. Skip it if you would rather
          install one app from its own release. Apps installed by a package are shown and left
          alone.
        </p>
        {welcome.app.cardShot && welcome.app.cardAlt && welcome.app.cardCaption && (
          <Shot name={welcome.app.cardShot} alt={welcome.app.cardAlt} caption={welcome.app.cardCaption} />
        )}
        <ReleaseBlock slug="welcome" heading="h3" />
      </section>
    )
  }

  <h2>The apps</h2>
  <p>
    Files, Terminal, Edit and Notes start pinned in the dock. Each of these also runs on its own,
    on a desktop that is not Rivet Shell.
  </p>

  <ul class="cards">
    {
      appRows.map(({ app, release, status }) => (
        <li>
          <a class="card" href={url(`${app.slug}/`)}>
            {app.cardShot && table[app.cardShot] && (
              <img
                class="card-shot"
                src={url(`screenshots/${app.cardShot}`)}
                alt={app.cardAlt ?? `${app.name} screenshot`}
                width={table[app.cardShot].w}
                height={table[app.cardShot].h}
                decoding="async"
              />
            )}
            <span class="card-copy">
              <span class={`badge badge-${status}`}>{statusLabel[status]}</span>
              <span class="card-name">
                {app.icon && (
                  <img class="card-icon" src={url(app.icon)} width="32" height="32" alt="" />
                )}
                {app.name}
              </span>
              {release && (
                <span class="card-version">
                  {release.prerelease
                    ? `${release.version} pre-release, ${release.dateLabel}`
                    : `${release.version}, ${release.dateLabel}`}
                </span>
              )}
              <span class="card-summary">{app.summary}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
