  <script is:inline>
    (function () {
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var coarse = window.matchMedia("(pointer: coarse)").matches;
      if (!reduce) {
        var nodes = document.querySelectorAll(".reveal");
        function shown(el) {
          var r = el.getBoundingClientRect();
          return r.top < (window.innerHeight || 0) * 0.92 && r.bottom > 0;
        }
        if ("IntersectionObserver" in window) {
          var io = new IntersectionObserver(
            function (entries) {
              for (var i = 0; i < entries.length; i++) {
                if (entries[i].isIntersecting) {
                  entries[i].target.classList.add("is-in");
                  io.unobserve(entries[i].target);
                }
              }
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
          );
          for (var j = 0; j < nodes.length; j++) {
            if (shown(nodes[j])) nodes[j].classList.add("is-in");
            else io.observe(nodes[j]);
          }
        } else {
          for (var k = 0; k < nodes.length; k++) nodes[k].classList.add("is-in");
        }
        document.documentElement.classList.add("motion");
      }
      var brut = document.querySelector(".brut");
      if (brut && !reduce && !coarse) {
        brut.addEventListener(
          "pointermove",
          function (e) {
            var box = brut.getBoundingClientRect();
            if (!box.width) return;
            var x = (e.clientX - (box.left + box.width / 2)) / box.width;
            var y = (e.clientY - (box.top + box.height / 2)) / box.height;
            brut.style.setProperty("--bx", (x * 12).toFixed(1) + "px");
            brut.style.setProperty("--by", (y * 8).toFixed(1) + "px");
          },
          { passive: true }
        );
      }
      var ring = document.querySelector(".accent-ring");
      if (ring && !reduce) {
        var balls = ring.querySelectorAll("li");
        var rx = 0;
        var ry = 0;
        var rsy = 0;
        var ringQueued = false;
        function paintRing() {
          ringQueued = false;
          for (var n = 0; n < balls.length; n++) {
            var depth = 0.42 + (n % 3) * 0.26;
            var x = coarse ? 0 : rx * 7 * depth;
            var y = ((coarse ? 0 : ry * 5) + rsy * 9) * depth;
            balls[n].style.setProperty("--px", x.toFixed(2) + "px");
            balls[n].style.setProperty("--py", y.toFixed(2) + "px");
          }
        }
        function queueRing() {
          if (!ringQueued) {
            ringQueued = true;
            requestAnimationFrame(paintRing);
          }
        }
        if (!coarse) {
          window.addEventListener(
            "pointermove",
            function (e) {
              var box = ring.getBoundingClientRect();
              if (!box.width) return;
              rx = Math.max(-0.85, Math.min(0.85, (e.clientX - (box.left + box.width / 2)) / box.width));
              ry = Math.max(-0.85, Math.min(0.85, (e.clientY - (box.top + box.height / 2)) / box.height));
              queueRing();
            },
            { passive: true }
          );
        }
        window.addEventListener(
          "scroll",
          function () {
            var box = ring.getBoundingClientRect();
            var vh = window.innerHeight || 1;
            rsy = Math.max(-1, Math.min(1, (vh * 0.45 - (box.top + box.height / 2)) / vh));
            queueRing();
          },
          { passive: true }
        );
      }
      if (reduce || coarse) return;
      var stage = document.querySelector(".hero-stage");
      if (!stage) return;
      var back = stage.querySelector(".hero-layer-back");
      var front = stage.querySelector(".hero-layer-front");
      var px = 0;
      var py = 0;
      var sy = 0;
      var queued = false;
      function paint() {
        queued = false;
        back.style.setProperty("--nx", (px * 8).toFixed(2) + "px");
        back.style.setProperty("--ny", (py * 5 + sy * 8).toFixed(2) + "px");
        front.style.setProperty("--nx", (px * 14).toFixed(2) + "px");
        front.style.setProperty("--ny", (py * 9 + sy * 14).toFixed(2) + "px");
      }
      function queue() {
        if (!queued) {
          queued = true;
          requestAnimationFrame(paint);
        }
      }
      window.addEventListener(
        "pointermove",
        function (e) {
          var r = stage.getBoundingClientRect();
          if (!r.width || r.bottom < 0 || r.top > window.innerHeight) return;
          px = (e.clientX - (r.left + r.width / 2)) / r.width;
          py = (e.clientY - (r.top + r.height / 2)) / r.height;
          queue();
        },
        { passive: true }
      );
      window.addEventListener(
        "scroll",
        function () {
          var r = stage.getBoundingClientRect();
          sy = Math.max(-1, Math.min(1, -r.top / (window.innerHeight || 1)));
          queue();
        },
        { passive: true }
      );
    })();
  </script>
