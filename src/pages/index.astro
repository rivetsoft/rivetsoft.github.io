---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import ReleaseBlock from "../components/ReleaseBlock.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { appCategories, apps, byReleaseStatus, repoUrl, statusFor, statusLabel } from "../data/apps";
import { catalog, releaseFor } from "../data/releases";
import { screenshot, shotSizes } from "../data/shots";
import Screenshot from "../components/Screenshot.astro";
import { url } from "../paths";
import { breadcrumb, siteRoot, websiteAndPerson } from "../seo";
import heroDesktop from "../assets/hero/hero-desktop.jpg";
import heroFiles from "../assets/hero/hero-files.png";

const rows = apps.map((app) => {
  const release = releaseFor(app.slug);
  return { app, release, status: statusFor(app, release), shot: app.cardShot ? screenshot(app.cardShot) : undefined };
});

const welcome = rows.find((row) => row.app.spotlight === "welcome");
const desktopRows = rows.filter((row) => row.app.spotlight === "desktop");
const desktopRow = (slug: string) => desktopRows.find((row) => row.app.slug === slug);
const shellRow = desktopRow("shell");
const softcoreRow = desktopRow("softcore");
// The Apps section's groups, in the order appCategories gives them. A group with nothing listed yet is left out.
const appGroups = appCategories
  .map((category) => ({
    ...category,
    rows: byReleaseStatus(rows.filter((row) => !row.app.spotlight && row.app.category === category.id)),
  }))
  .filter((group) => group.rows.length > 0);
const appCount = appGroups.reduce((sum, group) => sum + group.rows.length, 0);
const versionLine = (release: { version: string; prerelease: boolean; dateLabel: string }) =>
  release.prerelease ? `${release.version} pre-release, ${release.dateLabel}` : `${release.version}, ${release.dateLabel}`;
const heroAlt = "Rivet Shell over a wallpaper of Rivet at dusk, with a Rivet Files window in front";

const description =
  "Nifty apps and tools for Linux. Like a dope file manager, note-taking, FTP client, code editor and terminal. On top of that we got rad tools for a desktop shell, compositor and adding squiglies to your screenshots. How badass is that!?!? Not only that, but we use robots to do our bidding — under the guise of human direction.";

// Rivet beside the Apps heading, drawn into the page so his words use the site's font.
import namedArt from "../assets/mascot/named.svg?raw";
// Rivet in pixels, for the grid floor of the last band.
import pixelArt from "../assets/mascot/rivet-pixel.svg?raw";
// Rivet on his island, for the Rivet Welcome band.
import Throwback from "../components/Throwback.astro";
// Rivet in the maker's note, owning up to how it was all made.
import vibesArt from "../assets/mascot/vibes.svg?raw";
import islandArt from "../assets/mascot/island.svg?raw";
---

<Base
  title="Rivetsoft"
  description={description}
  current="home"
  jsonLd={[...websiteAndPerson(description), breadcrumb([{ name: "Rivetsoft", url: siteRoot }])]}
>
  <div class="home-grid">
  <header class="hero">
  {/* A sunburst behind the screenshot: rays fanning out from where the desktop sits and fading
      before they reach the edges. The wallpaper has the halftone now, so the page doesn't. */}
  <div class="hero-plate" aria-hidden="true"></div>
    <div class="hero-copy">
      <img class="hero-shell" src={url("rivet-shell.svg")} width="128" height="128" alt="Rivet Shell" />
      <h1>Rivetsoft</h1>
      <p class="lede">{description}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={url("docs/getting-started/install/#get-started")}>Getting Started →</a>
        <a class="btn btn-secondary" href={url("docs/")}>Docs</a>
      </div>
      {
        catalog.source === "fallback" && (
          <p class="notice">GitHub was unreachable when this page was built. Versions below are the last saved release info.</p>
        )
      }
    </div>
    <figure class="hero-visual">
      <div class="hero-stage" role="img" aria-label={heroAlt}>
        <div class="hero-layer hero-layer-back">
          <Image
            src={heroDesktop}
            alt=""
            widths={[640, 960, 1280, 1600, 1920]}
            sizes="(min-width: 800px) 58vw, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div class="hero-layer hero-layer-front">
          <Image
            src={heroFiles}
            alt=""
            format="webp"
            widths={[480, 720, 1080, 1440]}
            sizes="(min-width: 800px) 36vw, 64vw"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </figure>
  </header>

  <section class="band band-facts reveal">
  <ul class="facts">
    <li>
      <span class="fact-icon pink" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2"></path>
        </svg>
      </span>
      <h3>One look</h3>
      <p>Menus, toolbars, Preferences, and the quick panel are the same. Colors, fonts, and icons follow the desktop.</p>
    </li>
    <li>
      <span class="fact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 4 7v10l8 4 8-4V7z"></path>
          <path d="M12 21V11M4 7l8 4 8-4"></path>
        </svg>
      </span>
      <h3>Rust, no GTK or Qt</h3>
      <p>The shell and the apps are written in Rust and draw with egui.</p>
    </li>
    <li>
      <span class="fact-icon yellow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <rect x="3" y="4" width="7" height="7" rx="1.5"></rect>
          <rect x="14" y="4" width="7" height="7" rx="1.5"></rect>
          <rect x="8" y="14" width="7" height="7" rx="1.5"></rect>
        </svg>
      </span>
      <h3>Together or apart</h3>
      <p>Each app runs on its own. Put them with the shell and they share a dock and colors.</p>
    </li>
    <li>
      <span class="fact-icon mint" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 4v10"></path>
          <path d="m8 10 4 4 4-4"></path>
          <path d="M5 19h14"></path>
        </svg>
      </span>
      <h3>Unified Install</h3>
      <p>Optional. It downloads a release, checks the sha256, and runs install.sh.</p>
    </li>
    <li>
      <span class="fact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <rect x="4" y="5" width="16" height="12" rx="2"></rect>
          <path d="M8 20h8"></path>
        </svg>
      </span>
      <h3>Theme Follows Your Wallpaper</h3>
      <p>The shell runs matugen on the wallpaper. The apps follow those colors, with no restart.</p>
    </li>
    <li>
      <span class="fact-icon yellow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="8"></circle>
          <path d="M4 12h16M12 4c2.5 2.5 2.5 13.5 0 16M12 4c-2.5 2.5-2.5 13.5 0 16"></path>
        </svg>
      </span>
      <h3>Wayland</h3>
      <p>The apps are for Linux. The shell needs a Wayland compositor with layer-shell, not GNOME.</p>
    </li>
    <li>
      <span class="fact-icon mint" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M12 3v4M12 17v4M5 12H3M21 12h-2"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </span>
      <h3>Draws when it changes</h3>
      <p>The shell paints with its own software renderer, and only when something on screen changed. No GPU.</p>
    </li>
    <li>
      <span class="fact-icon pink" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 4h7l5 5v11a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"></path>
          <path d="M14 4v5h5"></path>
        </svg>
      </span>
      <h3>Open source</h3>
      <p>MIT or Apache-2.0, at your option.</p>
    </li>
  </ul>
  </section>
  <svg class="grid-wave" viewBox="-20 -28 1240 268" preserveAspectRatio="none" aria-hidden="true">
    <path fill="currentColor" d="M-60 66C40 8 160 8 260 66S480 124 580 66 800 8 900 66 1120 124 1220 66L1220 280L-60 280Z" />
  </svg>
  </div>

  {/* The desktop: Rivet Shell and Softcore, side by side, ahead of the apps. */}
  <section class="band band-desktop reveal" aria-labelledby="desktop-title">
    <div class="desktop-head">
      <h2 id="desktop-title">Desktop</h2>
      <p>
        Rivet Shell draws the panel, dock, launcher and wallpaper. Softcore places your windows on a
        strip you scroll through. They're made for each other, and each one works without the other.
      </p>
    </div>
    <ul class="desktop-pair">
      {
        [
          { row: shellRow, role: "The shell", docs: "docs/shell/" },
          { row: softcoreRow, role: "The compositor", docs: "docs/softcore/" },
        ].map(
          ({ row, role, docs }) =>
            row && (
              <li class="desktop-card">
                {row.shot && (
                  <a class="desktop-shot-link" href={url(`${row.app.slug}/`)}>
                    <Screenshot class="desktop-shot" img={row.shot} alt={row.app.cardAlt ?? `${row.app.name} screenshot`} sizes={shotSizes.pair} />
                  </a>
                )}
                <div class="desktop-copy">
                  <p class="desktop-role">{role}</p>
                  <h3 class="desktop-name">
                    <a class="card-name" href={url(`${row.app.slug}/`)}>
                      {row.app.icon && <img class="card-icon" src={url(row.app.icon)} width="32" height="32" alt="" />}
                      {row.app.name}
                    </a>
                  </h3>
                  <p class="desktop-status">
                    <span class={`badge badge-${row.status}`}>{statusLabel[row.status]}</span>
                    {row.release && <span class="card-version">{versionLine(row.release)}</span>}
                  </p>
                  <p class="card-summary">{row.app.line}</p>
                  {row.app.homePoints && (
                    <ul class="show-points">
                      {row.app.homePoints.map((point) => (
                        <li>
                          <Throwback name={point.icon} />
                          <span>{point.text}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {row.app.slug === "softcore" && (
                    <p class="desktop-note">An early pre-release that has run on one computer so far, so keep another session to log in to.</p>
                  )}
                  <p class="desktop-links">
                    <a class="show-more" href={url(`${row.app.slug}/`)}>
                      Go Deeper<span class="vh"> into {row.app.name}</span> <svg class="show-arrow" viewBox="0 0 24 16" aria-hidden="true">
                        <path d="M1 8h20M14 1.5 21.5 8 14 14.5" />
                      </svg>
                    </a>
                    <a href={url(docs)}>Docs<span class="vh"> for {row.app.name}</span></a>
                    {row.release && (
                      <a href={url(`${row.app.slug}/#download`)}>
                        {row.release.prerelease ? `Download the ${row.release.version} pre-release` : `Download ${row.release.version}`}
                        <span class="vh"> of {row.app.name}</span>
                      </a>
                    )}
                  </p>
                </div>
              </li>
            )
        )
      }
    </ul>
    <ul class="desktop-ways">
      <li>
        <h3>Together</h3>
        <p>Rivet Shell shows Softcore's workspaces and windows, and both take their colors from your wallpaper.</p>
      </li>
      <li>
        <h3>Rivet Shell on its own</h3>
        <p>It runs on niri, Hyprland, Sway and other compositors with layer-shell. Not on GNOME.</p>
      </li>
      <li>
        <h3>Softcore on its own</h3>
        <p>Any panel or dock made for layer-shell compositors works on it.</p>
      </li>
    </ul>
  </section>

  <section class="band band-apps reveal" aria-labelledby="apps-title">
    <div class="apps-head">
      <div class="apps-head-copy">
        <h2 id="apps-title">Apps</h2>
        <p>Each app runs on its own, with or without Rivet Shell and Softcore.</p>
      </div>
      <div
        class="apps-rivet"
        role="img"
        aria-label="Rivet, the mascot, stands in a folder, looks down at the apps and says: They named all of these after me. I don't know what any of them do."
        set:html={namedArt}
      />
    </div>
    {/* The filter shows one group at a time. Without the script it stays hidden and every group shows. */}
    <div class="app-filter" role="group" aria-labelledby="app-filter-label" data-app-filter hidden>
      <span class="app-filter-label" id="app-filter-label">Show</span>
      <button type="button" class="chip" data-category="all" aria-pressed="true">
        All <span class="chip-count">{appCount}</span>
      </button>
      {
        appGroups.map((group) => (
          <button type="button" class="chip" data-category={group.id} data-label={group.label} aria-pressed="false">
            {group.label} <span class="chip-count">{group.rows.length}</span>
          </button>
        ))
      }
    </div>
    <p class="vh" aria-live="polite" data-app-filter-status></p>
    {
      appGroups.map((group) => (
        <section class="app-group" id={`apps-${group.id}`} data-category={group.id} aria-labelledby={`apps-${group.id}-title`}>
          <h3 class="app-group-title" id={`apps-${group.id}-title`}>
            {group.label} <span class="app-group-count">{group.rows.length === 1 ? "1 app" : `${group.rows.length} apps`}</span>
          </h3>
          <ul class="showcase">
            {
            group.rows.map(({ app, release, status, shot }) => (
              <li class="show-row">
                {shot && (
                  <a class="show-shot-link" href={url(`${app.slug}/`)}>
                    <Screenshot class="show-shot" img={shot} alt={app.cardAlt ?? `${app.name} screenshot`} sizes={shotSizes.row} />
                  </a>
                )}
                <div class="show-copy">
                  <span class={`badge badge-${status}`}>{statusLabel[status]}</span>
                  <a class="card-name" href={url(`${app.slug}/`)}>
                    {app.icon && (
                      <img class="card-icon" src={url(app.icon)} width="32" height="32" alt="" />
                    )}
                    {app.name}
                  </a>
                  {release && (
                    <span class="card-version">
                      {versionLine(release)}
                    </span>
                  )}
                  {app.homePoints ? (
                    <>
                      <span class="card-summary">{app.line}</span>
                      <ul class="show-points">
                        {app.homePoints.map((point) => (
                          <li>
                            <Throwback name={point.icon} />
                            <span>{point.text}</span>
                          </li>
                        ))}
                      </ul>
                    </>
                  ) : (
                    <span class="card-summary">{app.summary}</span>
                  )}
                  <a class="show-more" href={url(`${app.slug}/`)} aria-label={`Go deeper into ${app.name}`}>
                    Go Deeper <svg class="show-arrow" viewBox="0 0 24 16" aria-hidden="true">
                      <path d="M1 8h20M14 1.5 21.5 8 14 14.5" />
                    </svg>
                  </a>
                </div>
              </li>
            ))
            }
          </ul>
        </section>
      ))
    }
  </section>

  <script is:inline>
    (function () {
      var bar = document.querySelector("[data-app-filter]");
      if (!bar) return;
      var chips = bar.querySelectorAll("button[data-category]");
      var groups = document.querySelectorAll(".app-group");
      var status = document.querySelector("[data-app-filter-status]");
      var ids = [];
      for (var g = 0; g < groups.length; g++) ids.push(groups[g].getAttribute("data-category"));
      function show(id, announce) {
        if (ids.indexOf(id) < 0) id = "all";
        var label = "";
        var count = 0;
        for (var c = 0; c < chips.length; c++) {
          var on = chips[c].getAttribute("data-category") === id;
          chips[c].setAttribute("aria-pressed", on ? "true" : "false");
          if (on) label = chips[c].getAttribute("data-label") || "";
        }
        for (var n = 0; n < groups.length; n++) {
          var hide = id !== "all" && groups[n].getAttribute("data-category") !== id;
          groups[n].hidden = hide;
          if (!hide) count += groups[n].querySelectorAll(".show-row").length;
        }
        if (announce && status) {
          var apps = count === 1 ? "1 app" : count + " apps";
          status.textContent = id === "all" ? "Showing all " + apps + "." : "Showing " + apps + " in " + label + ".";
        }
      }
      // ?type=development opens the page with that group chosen, so a filtered list can be shared.
      bar.addEventListener("click", function (e) {
        var chip = e.target.closest("button[data-category]");
        if (!chip) return;
        var id = chip.getAttribute("data-category");
        show(id, true);
        var link = new URL(window.location.href);
        if (id === "all") link.searchParams.delete("type");
        else link.searchParams.set("type", id);
        history.replaceState(null, "", link);
      });
      show(new URLSearchParams(window.location.search).get("type") || "all", false);
      bar.hidden = false;
    })();
  </script>

  {
    welcome && (
      <section class="band band-welcome reveal" aria-labelledby="welcome-title">
        <div class="welcome-layout">
          <div class="welcome-copy">
            <p class="welcome-kicker">Get the apps</p>
            <h2 id="welcome-title" class="spot-title">
              {welcome.app.icon && (
                <img src={url(welcome.app.icon)} width="40" height="40" alt="" />
              )}
              {welcome.app.name}
            </h2>
            <StatusBadge app={welcome.app} release={welcome.release} />
            <p>
              The way to install the set. It downloads each release, checks the sha256, and runs
              install.sh, so the programs land in <code>~/.local/bin</code> and in your launcher. A
              tray icon looks for newer versions after you sign in. Skip it if you would rather
              install one app from its own release. Apps installed by a package are shown and left
              alone.
            </p>
            <ReleaseBlock slug="welcome" heading="h3" />
          </div>
          {/* Rivet on his island stands where the screenshot was: the home page has plenty of
              those, and the app's own page still shows it. */}
          <div
            class="welcome-rivet"
            role="img"
            aria-label="Rivet, the mascot, lies on a lounge chair on a tiny island in sunglasses, under a palm tree, sipping from a coconut. Shark fins circle in the water."
            set:html={islandArt}
          />
        </div>
      </section>
    )
  }

  <section class="band band-colors scheme reveal" aria-labelledby="scheme-title">
    <div class="colors-layout">
    <div class="colors-copy">
    <div class="accent-stage">
    <ul class="accent-ring" aria-label="Nine accents">
          <li style="--i:0"><span class="rivet-upright"><span class="rivet-float"><span class="rivet-dot" style="--dot:#3584e4" role="img" aria-label="Blue" title="Blue"></span></span></span></li>
          <li style="--i:1"><span class="rivet-upright"><span class="rivet-float"><span class="rivet-dot" style="--dot:#5e9c3c" role="img" aria-label="Green" title="Green"></span></span></span></li>
          <li style="--i:2"><span class="rivet-upright"><span class="rivet-float"><span class="rivet-dot" style="--dot:#1f9e9a" role="img" aria-label="Teal" title="Teal"></span></span></span></li>
          <li style="--i:3"><span class="rivet-upright"><span class="rivet-float"><span class="rivet-dot" style="--dot:#9141ac" role="img" aria-label="Purple" title="Purple"></span></span></span></li>
          <li style="--i:4"><span class="rivet-upright"><span class="rivet-float"><span class="rivet-dot" style="--dot:#d53f8c" role="img" aria-label="Pink" title="Pink"></span></span></span></li>
          <li style="--i:5"><span class="rivet-upright"><span class="rivet-float"><span class="rivet-dot" style="--dot:#e5a50a" role="img" aria-label="Yellow" title="Yellow"></span></span></span></li>
          <li style="--i:6"><span class="rivet-upright"><span class="rivet-float"><span class="rivet-dot" style="--dot:#e66100" role="img" aria-label="Orange" title="Orange"></span></span></span></li>
          <li style="--i:7"><span class="rivet-upright"><span class="rivet-float"><span class="rivet-dot" style="--dot:#c01c28" role="img" aria-label="Red" title="Red"></span></span></span></li>
          <li style="--i:8"><span class="rivet-upright"><span class="rivet-float"><span class="rivet-dot" style="--dot:#77767b" role="img" aria-label="Grey" title="Grey"></span></span></span></li>
    </ul>
    <div class="ring-hub" aria-hidden="true">
      <span class="ring-glow"></span>
      <span class="ring-mark"><img src={url("rivet-files.svg")} alt="" width="96" height="96" /></span>
    </div>
    </div>
      <div class="colors-lead">
          <h2 id="scheme-title">Colors Galore!</h2>
          <p>
            The apps follow your wallpaper colors as they change, through matugen or any other tool that
            writes the color file. Or pick one of nine accents, or a code theme such as Tokyo Night,
            Catppuccin, Dracula, Nord, or Gruvbox.
          </p>
          <p><a href={url("docs/colors/")}>How colors work →</a></p>
      </div>
    </div>
    <div class="colors-side">
    <ul class="scheme-grid">
      <li>
        <Screenshot img={screenshot("theme-rose-wide.png")} alt="Rivet Files in the rose theme, on a light pink page" sizes={shotSizes.swatch} />
        <span>Rose</span>
      </li>
      <li>
        <Screenshot img={screenshot("theme-ember-wide.png")} alt="The same Files window in the ember accent" sizes={shotSizes.swatch} />
        <span>Ember</span>
      </li>
      <li>
        <Screenshot img={screenshot("theme-moss-wide.png")} alt="The same Files window in the moss accent" sizes={shotSizes.swatch} />
        <span>Moss</span>
      </li>
      <li>
        <Screenshot img={screenshot("theme-violet-wide.png")} alt="The same Files window in the violet accent" sizes={shotSizes.swatch} />
        <span>Violet</span>
      </li>
    </ul>
      <ul class="preset-row" aria-label="A few code themes">
      <li class="preset" style="--bg:#1a1b26;--fg:#a9b1d6">
        <span>Tokyo Night</span>
        <span class="swatch"><i style="background:#bb9af7"></i><i style="background:#9ece6a"></i><i style="background:#7aa2f7"></i><i style="background:#2ac3de"></i></span>
      </li>
      <li class="preset" style="--bg:#1e1e2e;--fg:#cdd6f4">
        <span>Catppuccin Mocha</span>
        <span class="swatch"><i style="background:#cba6f7"></i><i style="background:#a6e3a1"></i><i style="background:#89b4fa"></i><i style="background:#f9e2af"></i></span>
      </li>
      <li class="preset" style="--bg:#282a36;--fg:#f8f8f2">
        <span>Dracula</span>
        <span class="swatch"><i style="background:#ff79c6"></i><i style="background:#f1fa8c"></i><i style="background:#50fa7b"></i><i style="background:#8be9fd"></i></span>
      </li>
      <li class="preset" style="--bg:#2e3440;--fg:#d8dee9">
        <span>Nord</span>
