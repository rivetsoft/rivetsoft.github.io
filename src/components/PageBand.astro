---
// A page header in the home page's style: a blue band, flush under the site header, with a wavy yellow
// and pink edge along the bottom.
// The default slot is the words; the "art" slot is a picture beside them.
---

<section class="band band-cta band-page">
  <div class="cta-layout">
    <div class="cta-copy"><slot /></div>
    <div class="band-page-art"><slot name="art" /></div>
  </div>
  <svg class="cta-wave cta-wave-bottom" viewBox="-20 -28 1240 268" preserveAspectRatio="none" aria-hidden="true">
    <path class="cta-wave-cap" d="M-60 66C40 8 160 8 260 66S480 124 580 66 800 8 900 66 1120 124 1220 66L1220 -28L-60 -28Z" />
    <path transform="translate(28 36)" fill="#fff270" d="M-60 66C40 8 160 8 260 66S480 124 580 66 800 8 900 66 1120 124 1220 66L1220 128C1120 186 1000 186 900 128S680 70 580 128 360 186 260 128 40 70-60 128Z" />
    <path fill="#d53f8c" stroke="#24121b" stroke-width="10" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" d="M-60 66C40 8 160 8 260 66S480 124 580 66 800 8 900 66 1120 124 1220 66L1220 128C1120 186 1000 186 900 128S680 70 580 128 360 186 260 128 40 70-60 128Z" />
  </svg>
</section>

<style is:global>
  /* Flush under the site header: no wave on top, so less room is needed above the words. */
  .band-page {
    padding-top: 3.5rem;
  }
  .band-page::before {
    content: none;
  }
  @media (min-width: 800px) {
    .band-page {
      padding-top: 4.5rem;
    }
  }
  .band-page .cta-copy h1 {
    margin: 0;
    max-width: 12em;
    font-size: clamp(1.9rem, 4.2vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: #fff270;
    text-shadow: 4px 4px 0 #24121b;
  }
  .band-page .cta-copy p {
    max-width: 30em;
    color: #f7f2f4;
  }
  .band-page .cta-copy .band-page-lead {
    margin-top: 1rem;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .band-page .cta-copy .band-page-small {
    margin-top: 1.75rem;
    font-size: 0.875rem;
    opacity: 0.85;
  }
  .band-page-art img,
  .band-page-art svg {
    display: block;
    width: min(100%, 34rem);
    height: auto;
    margin-inline: auto;
  }
</style>
