---
// A screenshot as AVIF with a WebP fallback, in a few widths, so a phone downloads and decodes
// one about as wide as it shows it rather than the full-size picture.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  img: ImageMetadata;
  alt: string;
  /** How wide it shows, as the sizes attribute: the browser picks a width from it. */
  sizes: string;
  class?: string;
  /** Above the fold: load at once and ahead of other pictures. */
  eager?: boolean;
}

const { img, alt, sizes, class: className, eager = false } = Astro.props;
const largest = Math.min(img.width, 1600);
const widths = [...[480, 800, 1280].filter((w) => w < largest), largest];
---

<Picture
  src={img}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={["avif"]}
  fallbackFormat="webp"
  class={className}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  decoding="async"
/>
