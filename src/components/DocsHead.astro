---
import Default from "@astrojs/starlight/components/Head.astro";

const data = Astro.locals.starlightRoute.entry.data;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(`${import.meta.env.BASE_URL}og.jpg`, Astro.site).href;
const home = new URL(import.meta.env.BASE_URL, Astro.site).href;
const docs = new URL(`${import.meta.env.BASE_URL}docs/`, Astro.site).href;
const crumbs = [
  { name: "Rivet", url: home },
  { name: "Docs", url: docs },
];
if (!Astro.url.pathname.endsWith("/docs/")) {
  crumbs.push({ name: data.title, url: canonical });
}
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      headline: data.title,
      description: data.description,
      url: canonical,
      inLanguage: "en",
      image,
      author: {
        "@type": "Person",
        name: "Aaron Mazade",
        alternateName: "ulinaaron",
        url: "https://github.com/ulinaaron",
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        item: item.url,
      })),
    },
  ],
};
const json = JSON.stringify(graph).replace(/</g, "\\u003c");
const imageAlt = "Rivet Shell over a sunset wallpaper, with a Rivet Files window in front";
---

<Default />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
<script type="application/ld+json" set:html={json} />
