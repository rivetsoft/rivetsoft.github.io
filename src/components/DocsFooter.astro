---
import Default from "@astrojs/starlight/components/Footer.astro";
---

<div class="rivet-docs-foot">
  <Default />
  <p class="visits">Visits are counted with self-hosted Umami. No cookies, no personal data.</p>
</div>

<style>
  .rivet-docs-foot {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .visits {
    margin: 0 0 1.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
