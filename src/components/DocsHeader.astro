---
import Search from "@astrojs/starlight/components/Search.astro";
import SiteMenu from "./SiteMenu.astro";
---

<div class="docs-bar">
  <SiteMenu current="docs" />
  <div class="docs-search">
    <Search />
  </div>
</div>

<style>
  .docs-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem 1rem;
    width: 100%;
    height: 100%;
  }

  .docs-bar :global(.site-menu) {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
  }

  .docs-search {
    flex: 0 1 22rem;
  }

  .docs-search :global(button[data-open-modal]) {
    background: #3a2430;
    color: #e9dee5;
    border: 1px solid rgba(233, 222, 229, 0.45);
    border-radius: var(--radius-card);
    box-shadow: 3px 3px 0 #e9dee5;
    font-weight: 500;
  }

  :global(:root[data-theme="light"]) .docs-search :global(button[data-open-modal]) {
    background: #f7f2f4;
    color: #24121b;
    border-color: rgba(36, 18, 27, 0.4);
    box-shadow: 3px 3px 0 #24121b;
  }

  .docs-search :global(button[data-open-modal]:hover) {
    color: inherit;
    transform: none;
  }
</style>
