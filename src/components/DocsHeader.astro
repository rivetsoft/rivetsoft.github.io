---
import Search from "@astrojs/starlight/components/Search.astro";
import SiteMenu from "./SiteMenu.astro";
---

<div class="docs-bar">
  <SiteMenu current="docs" />
  <div class="docs-search">
    <Search />
  </div>
</div>

<style>
  .docs-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem 1rem;
    width: 100%;
    height: 100%;
  }

  .docs-bar :global(.site-menu) {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
  }

  .docs-search {
    flex: 0 1 22rem;
  }

  /* Below the width where the site's links fit in a row, the bar stays one line: the name, Menu,
     and search as a button, with Starlight's own menu button at the far right. The site's links
     open as a sheet under the bar, since the bar itself cannot grow. */
  @media (max-width: 959px) {
    .docs-bar :global(.site-menu) {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: flex-start;
      gap: 0.25rem;
    }

    .docs-bar :global(.brand) {
      flex: 0 1 auto;
      min-width: 0;
      white-space: nowrap;
    }

    .docs-bar :global(.menu-toggle) {
      flex: none;
      margin-left: 0.5rem;
    }

    .docs-search {
      flex: none;
    }

    .docs-bar :global(.site-nav.is-open) {
      position: fixed;
      top: var(--sl-nav-height);
      left: 0;
      right: 0;
      max-height: calc(100vh - var(--sl-nav-height));
      overflow-y: auto;
      padding: 0.5rem var(--sl-nav-pad-x) 1rem;
      background: var(--bg);
      box-shadow: 0 16px 28px -14px rgba(0, 0, 0, 0.6);
      z-index: 20;
    }
  }

  .docs-search :global(button[data-open-modal]) {
    background: #3a2430;
    color: #e9dee5;
    border: 1px solid rgba(233, 222, 229, 0.45);
    border-radius: var(--radius-card);
    box-shadow: 3px 3px 0 var(--shadow-hard);
    font-weight: 500;
  }

  :global(:root[data-theme="light"]) .docs-search :global(button[data-open-modal]) {
    background: #f7f2f4;
    color: #24121b;
    border-color: rgba(36, 18, 27, 0.4);
    box-shadow: 3px 3px 0 #24121b;
  }

  .docs-search :global(button[data-open-modal]:hover) {
    color: inherit;
    transform: none;
  }
</style>
