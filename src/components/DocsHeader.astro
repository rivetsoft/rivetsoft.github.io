---
import Search from "@astrojs/starlight/components/Search.astro";
import SiteMenu from "./SiteMenu.astro";
---

<div class="docs-bar">
  <SiteMenu current="docs" />
  <div class="docs-search">
    <Search />
  </div>
</div>

<style>
  .docs-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem 1rem;
    width: 100%;
    height: 100%;
  }

  .docs-bar :global(.site-menu) {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
  }

  .docs-search {
    flex: 0 1 22rem;
  }

  .docs-search :global(button[data-open-modal]) {
    background: transparent;
    color: var(--fg);
    border: 0;
    border-radius: 0;
    box-shadow: none;
    font-weight: 500;
  }

  .docs-search :global(button[data-open-modal]:hover) {
    background: transparent;
    color: var(--accent);
    transform: none;
    box-shadow: none;
  }
</style>
