---
import Search from "@astrojs/starlight/components/Search.astro";
import SiteMenu from "./SiteMenu.astro";
---

<div class="docs-bar">
  <SiteMenu current="docs" />
  <div class="docs-search">
    <Search />
  </div>
</div>

<style>
  .docs-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem 1rem;
    width: 100%;
    height: 100%;
  }

  .docs-bar :global(.site-menu) {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
  }

  .docs-search {
    flex: 0 1 22rem;
  }

  .docs-search :global(button[data-open-modal]) {
    background: #e9dee5;
    color: #24121b;
    border: 2px solid #24121b;
    border-radius: 10px;
    box-shadow: 3px 3px 0 #24121b;
  }

  .docs-search :global(button[data-open-modal]:hover) {
    border-color: #24121b;
    color: #24121b;
    background: #fff270;
  }
</style>
