---
import Screenshot from "./Screenshot.astro";
import { screenshot, shotSizes } from "../data/shots";

interface Props {
  name: string;
  alt: string;
  caption: string;
  eager?: boolean;
}

const { name, alt, caption, eager = false } = Astro.props;
const img = screenshot(name);
---

<figure class="shot">
  <a href={img.src}>
    <Screenshot img={img} alt={alt} sizes={shotSizes.page} eager={eager} />
    <span class="vh">Open full size.</span>
  </a>
  <figcaption>{caption}</figcaption>
</figure>
