---
// The site's header menu, on the site and in the docs: Apps (a mega menu of every app by group,
// with Rivet Welcome to install them), Desktop (Rivet Shell, its plugins, and Softcore), Docs and
// Blog. Coming soon apps are listed with a badge and no link, since they have no page yet.
// Without JavaScript, Apps and Desktop are plain links to their home page sections. On a
// phone, the menus open in place as sections of the Menu sheet.
import { appCategories, apps, appBySlug, repoUrl } from "../data/apps";
import { url } from "../paths";

interface Props {
  current?: string;
}

const { current = "" } = Astro.props;
const groups = appCategories
  .map((category) => ({ ...category, apps: apps.filter((app) => app.category === category.id) }))
  .filter((group) => group.apps.length > 0);
const welcome = appBySlug("welcome");
const shell = appBySlug("shell");
const softcore = appBySlug("softcore");
const desktopSoon = apps.filter((app) => app.spotlight === "desktop" && app.comingSoon);
const welcomeSoon = apps.filter((app) => app.spotlight === "welcome" && app.comingSoon);
const inApps = groups.some((group) => group.apps.some((app) => app.slug === current)) || current === "welcome";
const inDesktop = ["shell", "softcore", "plugins"].includes(current);
const here = (slug: string) => (current === slug ? "page" : undefined);
---

<div class="site-menu">
  <a class="brand" href={url()}>
    <img src={url("rivet-mark.svg")} width="28" height="30" alt="" />
    Rivetsoft
  </a>
  <button type="button" class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="site-nav">
    Menu
  </button>
  <nav id="site-nav" class="site-nav" aria-label="Pages">
    <div class="menu-item" data-menu>
      <a class="menu-top" href={url("#apps-title")} aria-current={inApps ? "true" : undefined} data-menu-link>Apps</a>
      <button type="button" class="menu-top" aria-expanded="false" aria-controls="menu-apps" data-menu-button hidden aria-current={inApps ? "true" : undefined}>
        Apps <svg class="menu-caret" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" /></svg>
      </button>
      <div class="menu-panel menu-panel-apps" id="menu-apps" data-menu-panel hidden>
        <div class="mega" style={`--cols: ${groups.length}`}>
          {
            groups.map((group) => (
              <section class="mega-col" aria-labelledby={`menu-${group.id}`}>
                <h2 class="mega-head" id={`menu-${group.id}`}>{group.label}</h2>
                <ul>
                  {group.apps.map((app) => {
                    const icon = app.icon ?? app.homeIcon;
                    const inner = (
                      <>
                        {icon ? <img src={url(icon)} width="32" height="32" alt="" /> : <span class="mega-blank" />}
                        <span>
                          <span class="mega-name">{app.name}</span>
                          {app.comingSoon && <span class="badge badge-soon mega-soon">Coming soon</span>}
                          <span class="mega-line">{app.line}</span>
                        </span>
                      </>
                    );
                    return (
                      <li>
                        {app.comingSoon ? (
                          <div class="mega-app is-soon">{inner}</div>
                        ) : (
                          <a class="mega-app" href={url(`${app.slug}/`)} aria-current={here(app.slug)}>
                            {inner}
                          </a>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </section>
            ))
          }
          <section class="mega-col mega-welcome" aria-labelledby="menu-welcome">
            <h2 class="mega-head" id="menu-welcome">Install them all</h2>
            {welcome.icon && <img class="mega-welcome-icon" src={url(welcome.icon)} width="48" height="48" alt="" />}
            <p class="mega-name">{welcome.name}</p>
            <p class="mega-line">{welcome.line}</p>
            <a class="mega-btn" href={url("docs/getting-started/install/#get-started")}>Install</a>
            <a class="mega-more" href={url("welcome/")} aria-current={here("welcome")}>About Rivet Welcome</a>
            {welcomeSoon.map((app) => (
              <div class="mega-app is-soon mega-beside">
                {app.icon && <img src={url(app.icon)} width="32" height="32" alt="" />}
                <span>
                  <span class="mega-name">{app.name}</span>
                  <span class="badge badge-soon mega-soon">Coming soon</span>
                  <span class="mega-line">{app.line}</span>
                </span>
              </div>
            ))}
          </section>
        </div>
        <p class="mega-foot">
          <a href={url("#apps-title")}>Every app on the home page</a>
          <a href={url("docs/apps/")}>Apps in the docs</a>
        </p>
      </div>
    </div>
    <div class="menu-item" data-menu>
      <a class="menu-top" href={url("#desktop-title")} aria-current={inDesktop ? "true" : undefined} data-menu-link>Desktop</a>
      <button type="button" class="menu-top" aria-expanded="false" aria-controls="menu-desktop" data-menu-button hidden aria-current={inDesktop ? "true" : undefined}>
        Desktop <svg class="menu-caret" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" /></svg>
      </button>
      <div class="menu-panel menu-panel-desktop" id="menu-desktop" data-menu-panel hidden>
        <div class="desk">
          {
            [
              { app: shell, role: "The shell", extra: true },
              { app: softcore, role: "The compositor", extra: false },
            ].map(({ app, role, extra }) => (
              <section class="desk-col" aria-labelledby={`menu-${app.slug}`}>
                <p class="mega-head">{role}</p>
                <a class="mega-app desk-app" href={url(`${app.slug}/`)} aria-current={here(app.slug)}>
                  {app.icon && <img src={url(app.icon)} width="48" height="48" alt="" />}
                  <span>
                    <span class="mega-name" id={`menu-${app.slug}`}>{app.name}</span>
                    <span class="mega-line">{app.line}</span>
                  </span>
                </a>
                <ul class="desk-links">
                  <li><a href={url(`docs/${app.slug}/`)}>{app.name} docs</a></li>
                  {extra && (
                    <li>
                      <a href={url("plugins/")} aria-current={here("plugins")}>Plugins for Rivet Shell</a>
                    </li>
                  )}
                </ul>
              </section>
            ))
          }
          {desktopSoon.map((app) => (
            <section class="desk-col" aria-labelledby={`menu-${app.slug}`}>
              <p class="mega-head">The login screen</p>
              <div class="mega-app desk-app is-soon">
                {app.icon && <img src={url(app.icon)} width="48" height="48" alt="" />}
                <span>
                  <span class="mega-name" id={`menu-${app.slug}`}>{app.name}</span>
                  <span class="badge badge-soon mega-soon">Coming soon</span>
                  <span class="mega-line">{app.line}</span>
                </span>
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
    <a href={url("docs/")} aria-current={here("docs")}>Docs</a>
    <a href={url("blog/")} aria-current={here("blog")}>Blog</a>
    <a class="repo" href={repoUrl} aria-label="GitHub repository" title="GitHub repository">
      <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
    </a>
    <button type="button" class="theme" id="theme" aria-label="Switch to dark theme" title="Switch to dark theme">
      <svg class="when-light" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M20 14.5A8.2 8.2 0 0 1 9.5 4 7 7 0 1 0 20 14.5z"></path>
      </svg>
      <svg class="when-dark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"></path>
        </g>
      </svg>
    </button>
  </nav>
</div>

<script is:inline>
  (function () {
    var nav = document.getElementById("site-nav");
    var menuBtn = document.getElementById("menu-toggle");
    var themeBtn = document.getElementById("theme");
    var wide = window.matchMedia("(min-width: 960px) and (hover: hover)");
    var items = Array.prototype.slice.call(document.querySelectorAll("[data-menu]"));
    var timers = new Map();

    if (menuBtn && nav) {
      menuBtn.addEventListener("click", function () {
        var open = !nav.classList.contains("is-open");
        nav.classList.toggle("is-open", open);
        menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }

    function parts(item) {
      return { button: item.querySelector("[data-menu-button]"), panel: item.querySelector("[data-menu-panel]") };
    }
    function setOpen(item, open) {
      var p = parts(item);
      p.panel.hidden = !open;
      p.button.setAttribute("aria-expanded", open ? "true" : "false");
      item.classList.toggle("is-open", open);
    }
    function closeAll(except) {
      items.forEach(function (item) {
        if (item !== except) setOpen(item, false);
      });
    }
    function later(item, fn, ms) {
      clearTimeout(timers.get(item));
      timers.set(item, setTimeout(fn, ms));
    }
    function links(item) {
      return Array.prototype.slice.call(parts(item).panel.querySelectorAll("a"));
    }

    // With the script, Apps and Desktop become buttons that open their menus; without it they stay links.
    items.forEach(function (item) {
      var p = parts(item);
      item.querySelector("[data-menu-link]").hidden = true;
      p.button.hidden = false;
      p.button.addEventListener("click", function () {
        var open = p.panel.hidden;
        closeAll(item);
        setOpen(item, open);
      });
      p.button.addEventListener("keydown", function (event) {
        if (event.key !== "ArrowDown") return;
        event.preventDefault();
        closeAll(item);
        setOpen(item, true);
        links(item)[0].focus();
      });
      p.panel.addEventListener("keydown", function (event) {
        if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
        var list = links(item);
        var at = list.indexOf(document.activeElement);
        if (at < 0) return;
        event.preventDefault();
        var next = event.key === "ArrowDown" ? Math.min(list.length - 1, at + 1) : at - 1;
        if (next < 0) p.button.focus();
        else list[next].focus();
      });
      item.addEventListener("focusout", function (event) {
        if (wide.matches && !item.contains(event.relatedTarget)) setOpen(item, false);
      });
      // On a wide screen with a mouse, a menu opens when the pointer rests on it a moment, and
      // closes a moment after it leaves, so crossing the gap to the panel doesn't shut it.
      item.addEventListener("mouseenter", function () {
        if (!wide.matches) return;
        later(item, function () {
          closeAll(item);
          setOpen(item, true);
        }, 120);
      });
      item.addEventListener("mouseleave", function () {
        if (!wide.matches) return;
        later(item, function () {
          if (!item.contains(document.activeElement)) setOpen(item, false);
        }, 250);
      });
    });

    document.addEventListener("click", function (event) {
      items.forEach(function (item) {
        if (!item.contains(event.target)) setOpen(item, false);
      });
    });
    document.addEventListener("keydown", function (event) {
      if (event.key !== "Escape") return;
      items.forEach(function (item) {
        if (item.classList.contains("is-open")) {
          setOpen(item, false);
          if (item.contains(document.activeElement)) parts(item).button.focus();
        }
      });
    });

    if (!themeBtn) return;
    function current() {
      if (document.documentElement.dataset.theme === "dark") return "dark";
      if (document.documentElement.dataset.theme === "light") return "light";
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }
    function label() {
      var text = current() === "dark" ? "Switch to light theme" : "Switch to dark theme";
      themeBtn.setAttribute("aria-label", text);
      themeBtn.setAttribute("title", text);
    }
    function store(theme) {
      try {
        localStorage.setItem("rivet-theme", theme);
        localStorage.setItem("starlight-theme", theme);
      } catch (e) {}
    }
    label();
    themeBtn.addEventListener("click", function () {
      var next = current() === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      store(next);
      label();
    });
  })();
</script>

<style>
  [hidden] {
    display: none !important;
  }

  .site-menu {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    min-height: 4rem;
  }

  .brand {
    margin-right: auto;
    color: var(--fg);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .brand img {
    width: 1.65rem;
    height: auto;
    display: block;
  }

  .menu-toggle,
  .menu-top,
  .theme,
  .site-nav > a {
    appearance: none;
    font: inherit;
    font-weight: 500;
    line-height: inherit;
    letter-spacing: inherit;
    color: var(--fg);
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    min-height: 44px;
    cursor: pointer;
  }

  .site-nav > a:hover,
  .site-nav > a:focus-visible,
  .menu-top:hover,
  .menu-top:focus-visible,
  .menu-item.is-open > .menu-top,
  .menu-toggle:hover,
  .theme:hover {
    color: var(--accent);
    background: transparent;
    box-shadow: none;
  }

  .site-nav > a[aria-current="page"],
  .menu-top[aria-current] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.22em;
    background: transparent;
  }

  .menu-toggle {
    padding: 0.35rem 0.85rem;
  }

  .theme {
    width: 44px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .theme svg {
    display: block;
  }

  .theme .when-dark {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme .when-light {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme .when-dark {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme .when-light {
      display: none;
    }

    :global(:root:not([data-theme="light"])) .theme .when-dark {
      display: block;
    }
  }

  .site-nav {
    display: none;
    flex-basis: 100%;
    flex-direction: column;
    align-items: stretch;
    gap: 0.15rem;
    padding-bottom: 0.75rem;
  }

  .site-nav.is-open {
    display: flex;
  }

  .site-nav > a,
  .menu-top {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0 0.55rem;
  }

  .menu-caret {
    width: 0.7rem;
    height: 0.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .menu-item.is-open .menu-caret {
    transform: rotate(180deg);
  }

  .repo {
    width: 44px;
    justify-content: center;
    padding-inline: 0;
  }

  /* The panels: a sheet with an ink outline and a hard shadow, like the site's stickers. */
  .menu-panel {
    margin: 0.25rem 0 0.5rem;
    padding: 0.9rem;
    border: 2px solid #24121b;
    background: var(--bg);
    color: var(--fg);
    box-shadow: 5px 5px 0 var(--shadow-hard);
  }

  .menu-panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu-panel li {
    margin: 0;
  }

  .mega,
  .desk {
    display: grid;
    gap: 1.1rem;
  }

  .mega-col,
  .desk-col {
    min-width: 0;
  }

  .mega-head {
    margin: 0 0 0.4rem;
    padding: 0 0.45rem;
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .menu-panel a {
    color: var(--fg);
  }

  .mega-app {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.45rem;
    min-height: 44px;
    box-sizing: border-box;
    text-decoration: none;
  }

  .mega-app img,
  .mega-blank {
    flex: none;
    width: 2rem;
    height: 2rem;
  }

  .desk-app img {
    width: 3rem;
    height: 3rem;
  }

  .mega-name,
  .mega-line {
    display: block;
  }

  .mega-name {
    font-weight: 700;
    color: var(--fg);
  }

  .mega-line {
    margin-top: 0.1rem;
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--muted);
  }

  .menu-panel .mega-app:hover,
  .menu-panel .mega-app:focus-visible,
  .menu-panel .mega-app[aria-current="page"] {
    background: #0084b8;
    color: #e9dee5;
  }

  .menu-panel .mega-app:hover .mega-name,
  .menu-panel .mega-app:hover .mega-line,
  .menu-panel .mega-app:focus-visible .mega-name,
  .menu-panel .mega-app:focus-visible .mega-line,
  .menu-panel .mega-app[aria-current="page"] .mega-name,
  .menu-panel .mega-app[aria-current="page"] .mega-line {
    color: #e9dee5;
  }

  /* A coming soon app: no page to go to yet, so no hover, and a small sticker of a badge. The
     docs load this menu without the site's badge styles, so it carries its own. */
  .mega-soon {
    display: inline-block;
    margin: 0.2rem 0 0.1rem;
    padding: 0.15rem 0.4rem;
    border: 1px solid #24121b;
    background: #8fd5ee;
    box-shadow: 2px 2px 0 var(--shadow-hard, #24121b);
    color: #24121b;
    font-size: 0.72rem;
    font-weight: 620;
    line-height: 1.1;
  }

  .mega-beside {
    align-self: stretch;
    margin-top: 0.5rem;
    padding: 0.6rem 0 0;
    border-top: 2px dashed #24121b;
  }

  /* Rivet Welcome's column is a yellow sticker: the one place to install everything. */
  .mega-welcome {
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 0.85rem;
    border: 2px solid #24121b;
    background: #fff270;
    color: #24121b;
    box-shadow: 3px 3px 0 #24121b;
  }

  .mega-welcome .mega-head,
  .mega-welcome .mega-name,
  .mega-welcome .mega-line {
    padding: 0;
    margin: 0;
    color: #24121b;
  }

  .mega-welcome-icon {
    width: 3rem;
    height: 3rem;
  }

  .menu-panel .mega-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 2px solid #24121b;
    background: #3ecf9a;
    color: #24121b;
    box-shadow: 3px 3px 0 #24121b;
    font: 700 0.85rem/1.2 "Space Mono", ui-monospace, monospace;
    text-decoration: none;
  }

  .menu-panel .mega-btn:hover {
    color: #24121b;
    background: #3ecf9a;
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 #24121b;
  }

  .menu-panel .mega-more {
    color: #24121b;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .mega-foot {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 0.9rem 0 0;
    padding: 0.75rem 0.45rem 0;
    border-top: 2px solid var(--line);
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .desk-links {
    display: grid;
    gap: 0.1rem;
    margin-top: 0.3rem !important;
    padding-left: 4.1rem !important;
  }

  .desk-links a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .menu-panel .desk-links a[aria-current="page"] {
    color: var(--accent);
  }

  @media (min-width: 960px) {
    .menu-toggle {
      display: none;
    }

    .site-nav {
      display: flex;
      flex-basis: auto;
      flex-direction: row;
      align-items: center;
      gap: 0.15rem;
      padding-bottom: 0;
    }

    /* On a wide screen a panel hangs under the header, at the right, over the page. */
    .menu-panel {
      position: absolute;
      top: calc(100% - 0.35rem);
      right: 0;
      z-index: 6;
      margin: 0;
      padding: 1.1rem;
      box-sizing: border-box;
    }

    .menu-panel-apps {
      width: min(76rem, 100%);
    }

    .mega {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr)) minmax(14.5rem, 1fr);
    }

    .menu-panel-desktop {
      width: min(40rem, 100%);
    }

    .desk {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
