---
import { appBySlug } from "../data/apps";
import { archiveFolder } from "../data/release-model";
import { releaseFor } from "../data/releases";
import { url } from "../paths";

interface Props {
  slugs: string[];
  /** Set false when the page already has a heading for this block. */
  heading?: boolean;
}

const { slugs, heading = true } = Astro.props;

const steps = slugs.map((slug) => {
  const app = appBySlug(slug);
  const release = releaseFor(slug);
  const archive = release?.assets.find((asset) => asset.kind === "archive");
  return { app, release, archive };
});
---

<div class="install-steps">
  {
    steps.map(({ app, release, archive }) => (
      <section>
        {
          heading && (
            <h2>
              <a href={url(`${app.slug}/`)}>{app.name}</a>
            </h2>
          )
        }
        {release?.prerelease && <p>Pre-release.</p>}
        {archive ? (
          <>
            <p>
              <a href={archive.url}>{archive.name}</a>
            </p>
            <pre>
              <code>{`tar xzf ${archive.name}\ncd ${archiveFolder(archive.name)}\n./install.sh`}</code>
            </pre>
          </>
        ) : (
          <p>No release yet.</p>
        )}
      </section>
    ))
  }
</div>

<style>
  .install-steps {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin: 2.25rem 0 3rem;
  }

  .install-steps h2 {
    margin: 0 0 0.85rem;
    font-size: 1.45rem;
  }

  .install-steps p {
    margin: 0 0 0.85rem;
  }

  .install-steps pre {
    margin: 0;
  }
</style>
