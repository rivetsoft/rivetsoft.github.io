---
interface Props {
  title: string;
  description: string;
  jsonLd?: unknown[];
  ogType?: string;
}

const { title, description, jsonLd = [], ogType = "website" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(`${import.meta.env.BASE_URL}og.jpg`, Astro.site);
const imageAlt = "Rivet Shell: panel, widgets and dock over a sunset wallpaper";
const json = JSON.stringify({ "@context": "https://schema.org", "@graph": jsonLd }).replace(/</g, "\\u003c");
---

<link rel="canonical" href={canonical.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={image.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content="Rivet" />
<meta property="og:locale" content="en" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image.href} />
<meta name="twitter:image:alt" content={imageAlt} />
{jsonLd.length > 0 && <script type="application/ld+json" set:html={json} />}
